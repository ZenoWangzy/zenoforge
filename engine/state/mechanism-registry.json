      "silence_hours": 12,
      "supervisor": "head-supervisor",
      "expected_idle": false
    },
    {
      "id": "fast-land-lane",
      "desc": "direct-main 快车道落地 worker 派发（落地链上的规则通道/预检在 worker 内）",
      "events": [
        {"base": "runtime", "file": "scheduler.log", "pattern": "dispatch land pid="}
