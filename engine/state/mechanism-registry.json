{
  "_doc": "M2 机制心跳登记表（#4495/#4498，全量登记 #4500 的 STPA 梳理产出，见 docs/agents/pipeline-stpa.md）。node_health.py 每次体检读这份表：events 列出机制应产生的事件（base=runtime 指向运行目录下的文件，如 scheduler.log、alerts/events.md、alerts/slo.md、bell.log、zombie-watch.log；base=agent_home 指向 $AGENT_HOME 下的文件，如 logs/main-red.log、supervisor-inbox；pattern 是行内正则，行首须带 ISO 时间戳，轮转的 .1 代也会读）；沉默超过 silence_hours 小时的机制计入 mechanism.silent。expected_idle=true 的机制允许长期无事件（触发条件可能 legitimately 不出现），只展示最近事件时间、不报警。supervisor 是机制沉默时要找的负责人：head-supervisor（调度器与传感器）、supervisor-arbiter（#4369 工厂仲裁）、night-supervisor（bell/夜间事件分诊）。沉默上限的依据是 10-28 解停后稳态事件间隔的度量，逐项列在 pipeline-stpa.md。",
  "mechanisms": [
    {
      "id": "scheduler-tick",
      "desc": "调度器每拍本身（回收→派发→门禁→发布）：拍完成即事件，拍停了整条工厂停摆",
      "events": [
        {"base": "runtime", "file": "scheduler.log", "pattern": "tick done units="}
      ],
      "silence_hours": 1,
      "supervisor": "head-supervisor",
      "expected_idle": false
    },
    {
      "id": "dispatch-implement",
      "desc": "implement/repair/review 派发（implement_cap、动态并发准入之内）",
      "events": [
        {"base": "runtime", "file": "scheduler.log", "pattern": "type=implement unit="},
        {"base": "runtime", "file": "alerts/events.md", "pattern": "IMPL-DELIVERED unit="}
      ],
      "silence_hours": 6,
      "supervisor": "head-supervisor",
      "expected_idle": false
    },
    {
      "id": "self-check-gate",
      "desc": "评审前确定性自检（构建/typecheck/lint，包测试委派 PR 门，重活在 cihost）",
