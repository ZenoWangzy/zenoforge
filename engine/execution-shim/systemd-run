#!/usr/bin/env bash
# Admission before launch, and one shared lifetime lease inside every worker unit.
set -euo pipefail
args=("$@")
unit=; command_at=-1
for ((i=0; i<${#args[@]}; i++)); do
  arg="${args[i]}"
  case "$arg" in
    --unit=*) unit="${arg#*=}" ;;
    --unit|-u) i=$((i+1)); unit="${args[i]:-}" ;;
    --) command_at=$((i+1)); break ;;
    -p|--property|-E|--setenv|--description|--working-directory|--service-type|--slice|--uid|--gid|--machine|--host)
      i=$((i+1)) ;;
    -*) ;;
    *) command_at=$i; break ;;
  esac
done
execution=0
case "$unit" in
  zf-implement-*|zf-triage-*|zf-recut-*|zf-advisor-*|zf-web-advisor-provider-*|zf-release-*|zf-node-owner-*|zf-hand-*|zf-land-direct-main-*|zf-post-land-*|zf-merge-*|zf-worktree-cleanup-*|zf-maintenance-*|zf-gitnexus-*) execution=1 ;;
esac
if ((command_at>=0 && command_at<${#args[@]})); then
  # Index refresh scopes have generated unit names. Ordinary graph reads stay reads.
  if [[ "${args[command_at]##*/}" == gitnexus* && "${args[command_at+1]:-}" == analyze ]]; then execution=1; fi
fi
real="${ZF_SYSTEMD_RUN_REAL:-}"
if [[ -z "$real" ]]; then
  shim_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
  search_path=""
  IFS=: read -r -a path_dirs <<< "$PATH"
  for dir in "${path_dirs[@]}"; do
    [[ "$dir" == "$shim_dir" ]] || search_path+="$dir:"
  done
  real="$(PATH="${search_path%:}" command -v systemd-run || true)"
  [[ -n "$real" ]] || { echo 'execution admission deferred: systemd-run unavailable' >&2; exit 75; }
fi
if ((execution)); then
  ((command_at>=0 && command_at<${#args[@]})) || { echo 'execution admission deferred: worker command unresolved' >&2; exit 75; }
  if [[ "$unit" == zf-release-* ]]; then
    # A release must not queue behind pipeline load (2026-10-29: load 46.5 over a
    # maximum of 12 deferred zf-release-batch while opt workers filled the box).
    # The unit name marks both admission stages: the check below and run-unit
    # inside the unit.
    export LUNA_PRIORITY=release
    args=("${args[@]:0:command_at}" -E LUNA_PRIORITY=release "${args[@]:command_at}")
    command_at=$((command_at+2))
  fi
  guard="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/execution-admission.py"
  if [[ "$unit" == zf-worktree-cleanup-* ]] && python3 "$guard" waiting -- "${args[@]:command_at}"; then
    exec "$real" "${args[@]}"  # This exact watcher admits only after its target exits.
  fi
  python3 "$guard" check || exit $?
  exec "$real" "${args[@]:0:command_at}" python3 "$guard" run-unit -- "${args[@]:command_at}"
fi
exec "$real" "${args[@]}"
