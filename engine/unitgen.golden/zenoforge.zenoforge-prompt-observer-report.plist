<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AGENT_HOME</key>
		<string>/zf-golden/.zenoforge</string>
		<key>MAC_AUTOPILOT_RUNTIME_DIR</key>
		<string>/zf-golden/.zenoforge/checkout/.scratch-supervisor/autopi</string>
		<key>MAC_AUTOPILOT_SUPERVISOR_DIR</key>
		<string>/zf-golden/.zenoforge/checkout/.scratch-supervisor</string>
		<key>PATH</key>
		<string>/zf-golden/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin</string>
		<key>ZF_HOME</key>
		<string>/zf-golden/.zenoforge</string>
		<key>ZF_REPO_DIR</key>
		<string>/zf-golden/.zenoforge/checkout</string>
	</dict>
	<key>Label</key>
	<string>zenoforge.zenoforge-prompt-observer-report</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>e="$(readlink -e "$AGENT_HOME/engine-live" 2&gt;/dev/null)"; if [ -n "$e" ]; then export ZF_ENGINE_DIR="$e" ZF_ENGINE_LIVE="$e"; [ -z "${ZF_PACK_DIR-}" ] || export ZF_PACK_DIR="$e"; fi; exec /bin/bash "${e:-$ZF_REPO_DIR/engine}/night/prompt-observer-run.sh"</string>
	</array>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>8192</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>/zf-golden/.zenoforge/logs/units/zenoforge-prompt-observer-report.log</string>
	<key>StandardOutPath</key>
	<string>/zf-golden/.zenoforge/logs/units/zenoforge-prompt-observer-report.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>5</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/zf-golden/.zenoforge/checkout</string>
</dict>
</plist>
