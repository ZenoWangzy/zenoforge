<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AGENT_HOME</key>
		<string>/home/zf-golden/.zenoforge</string>
		<key>PATH</key>
		<string>/home/zf-golden/.local/bin:/home/zf-golden/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin</string>
		<key>ZF_HOME</key>
		<string>/home/zf-golden/.zenoforge</string>
		<key>ZF_NIGHT_DIR</key>
		<string>/home/zf-golden/.zenoforge/night</string>
		<key>ZF_REPO_DIR</key>
		<string>/home/zf-golden/.zenoforge/checkout</string>
	</dict>
	<key>Label</key>
	<string>zenoforge.zenoforge-daily-perf-report</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>e="$(readlink -e /home/zf-golden/.zenoforge/engine-live 2&gt;/dev/null)"; if [ -n "$e" ]; then export ZF_ENGINE_DIR="$e" ZF_ENGINE_LIVE="$e"; [ -z "${ZF_PACK_DIR-}" ] || export ZF_PACK_DIR="$e"; for v in ZF_RELEASE_TRAIN_SCRIPT AGENT_INCIDENT_GUARDS_FILE ZF_PRODUCTION_TENANT_MARKER_EXCEPTIONS_FILE; do p="${!v-}"; case "$p" in /home/zf-golden/.zenoforge/engine-live/*) export "$v=$e/${p#/home/zf-golden/.zenoforge/engine-live/}";; esac; done; fi; exec "${e:-/home/zf-golden/.zenoforge/checkout/engine}/night/daily-perf-report.sh"</string>
	</array>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>8192</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>/home/zf-golden/.zenoforge/logs/units/zenoforge-daily-perf-report.log</string>
	<key>StandardOutPath</key>
	<string>/home/zf-golden/.zenoforge/logs/units/zenoforge-daily-perf-report.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/home/zf-golden/.zenoforge/checkout</string>
</dict>
</plist>
