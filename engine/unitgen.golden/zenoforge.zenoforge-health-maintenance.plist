		<key>ZF_WORKTREE_ROOT</key>
		<string>/home/zf-golden/wt</string>
		<key>http_proxy</key>
		<string>http://127.0.0.1:3128 https_proxy=http://127.0.0.1:3128</string>
		<key>no_proxy</key>
		<string>127.0.0.1,localhost,192.168.0.0/16,10.0.0.0/8</string>
	</dict>
	<key>Label</key>
	<string>zenoforge.zenoforge-health-maintenance</string>
	<key>ProgramArguments</key>
	<array>
		<string>timeout</string>
		<string>-k</string>
		<string>30</string>
		<string>360</string>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>e="$(readlink -e /home/zf-golden/.zenoforge/engine-live 2&gt;/dev/null)"; if [ -n "$e" ]; then export ZF_ENGINE_DIR="$e" ZF_ENGINE_LIVE="$e"; [ -z "${ZF_PACK_DIR-}" ] || export ZF_PACK_DIR="$e"; for v in ZF_RELEASE_TRAIN_SCRIPT AGENT_INCIDENT_GUARDS_FILE ZF_PRODUCTION_TENANT_MARKER_EXCEPTIONS_FILE; do p="${!v-}"; case "$p" in /home/zf-golden/.zenoforge/engine-live/*) export "$v=$e/${p#/home/zf-golden/.zenoforge/engine-live/}";; esac; done; fi; exec "${e:-/home/zf-golden/.zenoforge/checkout/engine}/night/health-maintenance.sh" maintenance</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>8192</integer>
	</dict>
	<key>StartInterval</key>
	<integer>600</integer>
	<key>WorkingDirectory</key>
	<string>/home/zf-golden/.zenoforge/checkout</string>
