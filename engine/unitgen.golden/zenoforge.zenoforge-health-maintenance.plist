		<string>/home/zf-golden/.zenoforge</string>
		<key>HTTP_PROXY</key>
		<string>http://127.0.0.1:3128 HTTPS_PROXY=http://127.0.0.1:3128</string>
		<key>NO_PROXY</key>
		<string>127.0.0.1,localhost,192.168.0.0/16,10.0.0.0/8</string>
		<key>PATH</key>
		<string>/home/zf-golden/.local/bin:/home/zf-golden/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin</string>
		<key>ZF_HOME</key>
		<string>/home/zf-golden/.zenoforge</string>
		<key>ZF_NIGHT_DIR</key>
		<string>/home/zf-golden/.zenoforge/night</string>
		<key>ZF_REPO_DIR</key>
