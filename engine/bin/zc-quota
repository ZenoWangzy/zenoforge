#!/usr/bin/env node
// zc-quota: read the GLM Coding Plan 5h/weekly quota from the maintainer's signed-in usage tab in the shared Chrome
// (127.0.0.1:9222, https://bigmodel.cn/coding-plan/personal/usage), pace ZCode so the 5h window is never used up,
// and spend one weekly reset once the weekly quota is used up (maintainer 10-30). Run by zf-zc-quota.timer.
// The page's own quota/limit response is read through CDP Network events, so no token passes through this script.
// Outputs: ~/.zenoforge/zc-quota.json (last reading), ~/.zenoforge/zcode-exhausted-until (epoch seconds; lib.sh's
// provider_quota_exhausted and bin/worker's zc breaker both read it), log lines on stdout (journal).
import fs from 'node:fs';
const HOME = process.env.HOME;
const STATE = `${HOME}/.zenoforge/zc-quota.json`;
const MARKER = `${HOME}/.zenoforge/zcode-exhausted-until`;
const QUOTA_MAX_AGE_SECONDS = Number(process.env.ZC_QUOTA_MAX_AGE_SECONDS || 900);
const CAP_5H = Number(process.env.ZC_5H_CAP || 85);              // stop starting ZCode at this 5h percentage
const CAP_WEEK = Number(process.env.ZC_WEEK_CAP || 100);          // stop starting ZCode here; a weekly reset normally comes first
const RESET_GAP_SECONDS = Number(process.env.ZC_WEEK_RESET_GAP_SECONDS || 21600); // one reset at a time: a slow page must not burn a second
const ALERT_FILE = process.env.ZC_ALERT_FILE;                     // each spent reset is appended here
// Founder 2026-11-08 (glm_factory_cap_2026_11_08): no weekly resets remain, so the default never spends one.
const RESET_WEEK_AT = Number(process.env.ZC_WEEK_RESET_AT || 101); // spend a weekly reset at this weekly percentage; over 100 never spends
const WEEK_ALERT_AT = Number(process.env.ZC_WEEK_ALERT_AT || 98); // below the spend line, tell head once per week at this percentage
// Production shares this GLM account and falls back to paid DeepSeek when it runs out: factory ZCode keeps under a straight
// line from 0% at the week start to WEEK_PACE% at the week reset, leaving the rest for production.
const WEEK_PACE = Number(process.env.ZC_WEEK_PACE_PCT || 90);
const WEEK_SECONDS = 7 * 86400;
// week percentage, week reset epoch, now epoch -> epoch until which ZCode holds, or 0 when under the line (or the window has not started)
const weekPaceUntil = (pct, reset, now) => {
  if (!reset || !(WEEK_PACE > 0)) return 0;
  const start = reset - WEEK_SECONDS;
  if (pct <= WEEK_PACE * (now - start) / WEEK_SECONDS) return 0;
  return Math.min(reset, Math.ceil(start + pct / WEEK_PACE * WEEK_SECONDS)); // when the line reaches today's percentage
};
if (process.argv[2] === '--self-test') {
  const r = 1_000_000_000, s = r - WEEK_SECONDS, assert = (c, m) => { if (!c) { console.error('FAIL', m); process.exit(1); } };
  assert(weekPaceUntil(30, r, s + 7 * 3600) === Math.ceil(s + 30 / WEEK_PACE * WEEK_SECONDS), 'over the line holds until the line catches up');
  assert(weekPaceUntil(10, r, s + 3 * 86400) === 0, 'under the line does not hold');
  assert(weekPaceUntil(95, r, r - 60) === r, 'over the pace at week end holds to the reset, never past it');
  assert(weekPaceUntil(30, null, s) === 0, 'a window that has not started never holds');
  console.log('zc-quota self-test ok'); process.exit(0);
}
const PAGE = 'https://bigmodel.cn/coding-plan/personal/usage';
const CDP = process.env.QUOTA_CDP_URL || 'http://127.0.0.1:9222';
const CALL_TIMEOUT_MS = Number(process.env.QUOTA_CDP_CALL_TIMEOUT_MS || 30000);
const RESPONSE_WAIT_MS = Number(process.env.QUOTA_RESPONSE_WAIT_MS || 40000); // the page's quota call after a navigate
const TAB_BOOK = `${STATE}.tab`;                                  // target id of the tab this script opened
const sleep = ms => new Promise(r => setTimeout(r, ms));
const log = (...a) => console.log(new Date().toISOString(), ...a);

function markSnapshotUnknown() {
  try {
    let previous = {};
    try { previous = JSON.parse(fs.readFileSync(STATE, 'utf8')); } catch {}
    fs.writeFileSync(STATE, JSON.stringify({ ...previous, freshness: 'unknown' }) + '\n');
  } catch (stateError) {
    log('could not mark quota snapshot unknown:', stateError.message);
  }
}

let pages;
try { pages = await (await fetch(`${CDP}/json/list`)).json(); }
catch (e) {
  markSnapshotUnknown();
  log('zc-quota failed:', e.message);
  process.exit(3);
}
// The booked id also matches a tab the site redirected: a URL match alone lost it and left no usage tab (11-06 08:48Z).
// A booked tab that left the site belongs to someone else now, so it is never navigated back.
const bookedTab = (() => { try { return fs.readFileSync(TAB_BOOK, 'utf8').trim(); } catch { return ''; } })();
let page = pages.find(p => p.type === 'page' && (p.url.startsWith(PAGE) || (p.id === bookedTab && new URL(p.url).hostname === new URL(PAGE).hostname)));
if (!page) {
  try { page = await (await fetch(`${CDP}/json/new?${PAGE}`, { method: 'PUT' })).json(); }
  catch (e) {
    markSnapshotUnknown();
    log('zc-quota failed: could not open the usage tab:', e.message);
    process.exit(3);
  }
  log('opened usage tab in the shared Chrome');
}
if (page.id !== bookedTab) fs.writeFileSync(TAB_BOOK, `${page.id}\n`);
const ws = new WebSocket(page.webSocketDebuggerUrl);
let id = 0; const waits = new Map(); let hits = [];
// A renderer that stopped answering held one run open 5h and froze the snapshot.
const call = (method, params = {}) => new Promise((r, reject) => {
  const i = ++id, t = setTimeout(() => reject(new Error(`CDP ${method} no reply in ${CALL_TIMEOUT_MS}ms`)), CALL_TIMEOUT_MS);
  waits.set(i, m => { clearTimeout(t); r(m); });
  ws.send(JSON.stringify({ id: i, method, params }));
});
ws.onmessage = e => {
  const m = JSON.parse(e.data);
  if (m.id) return waits.get(m.id)?.(m);
  if (m.method === 'Network.responseReceived' && /\/api\/monitor\/usage\/quota\/limit|reset/i.test(m.params.response.url))
    hits.push({ requestId: m.params.requestId, url: m.params.response.url });
  if (m.method === 'Network.loadingFinished') { const h = hits.find(x => x.requestId === m.params.requestId); if (h) h.done = true; }
};
const evaluate = async expression => (await call('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true })).result?.result?.value;
const body = async h => (await call('Network.getResponseBody', { requestId: h.requestId })).result?.body;

// navigate, not reload: reload kept the chrome-error page after a network timeout. 40 s default: at load5 ~20 the page's quota call took longer than 15 s (10-30 15:22Z).
async function awaitQuotaReply() {
  hits = [];
  await call('Page.navigate', { url: PAGE });
  for (let i = 0; i < RESPONSE_WAIT_MS / 500 && !hits.some(h => h.done && /quota\/limit/.test(h.url)); i++) await sleep(500);
  return hits.find(x => x.done && /quota\/limit/.test(x.url));
}

async function readQuota() {
  let h = await awaitQuotaReply();
  if (!h) {
    // A signed-out tab sits on a login page and never sends the quota call: a second reload cannot help.
    const at = await evaluate('location.href').catch(() => '');
    if (/login|signin|sign-in/i.test(at || '')) throw new Error(`signed out: the usage tab is at ${at} (not retried)`);
    log('usage response not seen after reload: retrying the reload once');
    h = await awaitQuotaReply();
  }
  if (!h) throw new Error('quota/limit response not seen after reload (signed out?)');
  const limits = JSON.parse(await body(h)).data?.limits || [];
  const tok = unit => limits.find(l => l.type === 'TOKENS_LIMIT' && l.unit === unit);
  const five = tok(3), week = tok(6);  // unit 3 = hours (number 5), unit 6 = week (number 1)
  if (!five || !week) throw new Error(`unexpected quota shape: ${JSON.stringify(limits).slice(0, 300)}`);
  // nextResetTime is absent while a window has not started (right after a reset, 10-30 16:28Z).
  const at = t => t ? Math.floor(t / 1000) : null;
  return { five_h_pct: five.percentage, five_h_reset: at(five.nextResetTime),
           week_pct: week.percentage, week_reset: at(week.nextResetTime) };
}

// Opens 重置管理 and clicks 使用 on the first (soonest-expiring, 优先) weekly reset, then any confirm button.
async function spendWeeklyReset() {
  return evaluate(`(async () => {
    const wait = ms => new Promise(r => setTimeout(r, ms));
    // The reset card renders after the quota call; at 16:18Z/16:23Z it was not there yet.
    const find = () => [...document.querySelectorAll('a,button,span,div')].find(e => e.innerText && e.innerText.trim() === '重置管理');
    let open = find();
    for (let i = 0; i < 30 && !open; i++) { await wait(500); open = find(); }
    if (!open) return 'no 重置管理 entry';
    open.click(); await wait(2500);
    const groups = [...document.querySelectorAll('*')].filter(e => e.innerText && e.innerText.trim().startsWith('周额度')
      && !e.innerText.includes('5小时额度') && e.querySelector('button.reset-quota-dialog__action'));
    const group = groups.sort((a, b) => a.innerText.length - b.innerText.length)[0];
    if (!group) return 'no weekly reset group';
    const remaining = (group.innerText.match(/可用(\\d+)次/) || [])[1];
    if (remaining === '0') return 'no weekly resets left';
    group.querySelector('button.reset-quota-dialog__action').click(); await wait(2000);
    const confirm = [...document.querySelectorAll('button')].filter(b => b.offsetParent && /^(确定|确认|确认重置|确认使用)$/.test(b.innerText.trim()));
    if (confirm.length) { confirm[confirm.length - 1].click(); await wait(3000); }
    return 'clicked weekly reset (remaining before ' + remaining + ', confirm ' + confirm.length + ')';
  })()`);
}

try {
  await new Promise((r, j) => { ws.onopen = r; ws.onerror = j; });
  await call('Network.enable').catch(async e => {
    await fetch(`${CDP}/json/close/${page.id}`);  // the next run opens a new tab
    log('closed the unresponsive usage tab');
    throw e;
  });
  let q = await readQuota();
  const prev = (() => { try { return JSON.parse(fs.readFileSync(STATE, 'utf8')); } catch { return {}; } })();
  q.reset_at = prev.reset_at || 0;
  q.week_resets_spent = prev.week_resets_spent || 0;
  q.week_alert_for = prev.week_alert_for;
  if (q.week_pct >= RESET_WEEK_AT && Date.now() / 1000 - q.reset_at < RESET_GAP_SECONDS) {
    log(`weekly ${q.week_pct}% but the last reset was under ${RESET_GAP_SECONDS}s ago: not spending another`);
  } else if (q.week_pct >= RESET_WEEK_AT) {
    log(`weekly ${q.week_pct}% >= ${RESET_WEEK_AT}%: spending one weekly reset`);
    // Persist before the click: a failed re-read after it must not allow a second reset.
    fs.writeFileSync(STATE, JSON.stringify({ ...prev, reset_at: Math.floor(Date.now() / 1000) }) + '\n');
    const result = await spendWeeklyReset();
    log(result);
    for (const h of hits.filter(x => x.done && /reset/i.test(x.url))) log('reset response', h.url, (await body(h) || '').slice(0, 300));
    const spent = { reset_at: Math.floor(Date.now() / 1000), week_resets_spent: q.week_resets_spent };
    q = { ...(await readQuota()), ...spent };
    log(`after reset: 5h ${q.five_h_pct}% weekly ${q.week_pct}%`);
    if (/^clicked/.test(result || '')) {
      q.week_resets_spent += 1;
      const left = Number(result.match(/remaining before (\d+)/)?.[1]) - 1;
      if (ALERT_FILE) fs.appendFileSync(ALERT_FILE, `[${new Date().toISOString()}] ZCODE-WEEK-RESET spent=${q.week_resets_spent} left=${left} ${result}; weekly now ${q.week_pct}%\n`);
    }
  }
  if (q.week_pct >= WEEK_ALERT_AT && q.week_pct < RESET_WEEK_AT && q.week_alert_for !== String(q.week_reset)) {
    q.week_alert_for = String(q.week_reset);
    log(`weekly ${q.week_pct}%: the reset waits for the head, not spending one`);
    if (ALERT_FILE) fs.appendFileSync(ALERT_FILE, `[${new Date().toISOString()}] ZCODE-WEEK-RESET-HELD weekly ${q.week_pct}%, automatic reset off at ${RESET_WEEK_AT}%: the last reset waits for the head\n`);
  }
  const now = Math.floor(Date.now() / 1000);
  const marker = (() => { try { return Number(fs.readFileSync(MARKER, 'utf8').trim()); } catch { return 0; } })();
  const paceUntil = weekPaceUntil(q.week_pct, q.week_reset, now);
  q.week_pace_line = q.week_reset ? Math.round(WEEK_PACE * (now - (q.week_reset - WEEK_SECONDS)) / WEEK_SECONDS * 10) / 10 : null;
  if (q.five_h_pct >= CAP_5H || q.week_pct >= CAP_WEEK || paceUntil) {
    const until = Math.max(q.week_pct >= CAP_WEEK ? q.week_reset : 0, q.five_h_pct >= CAP_5H ? q.five_h_reset : 0, paceUntil);
    if (until > marker) fs.writeFileSync(MARKER, `${until}\n`);
    q.marker_written = Math.max(until, marker);
    const why = paceUntil ? `week pace line ${q.week_pace_line}% of ${WEEK_PACE}%` : 'cap';
    log(`hold ZCode until ${new Date(until * 1000).toISOString()}: 5h ${q.five_h_pct}% weekly ${q.week_pct}% (${why})`);
  } else if (prev.marker_written && marker === prev.marker_written && marker > now) {
    // Only clear a hold this script wrote; a provider refusal's marker stays. MARKER may be a symlink: readers see its target.
    fs.rmSync(fs.realpathSync(MARKER), { force: true });
    log(`release ZCode hold: 5h ${q.five_h_pct}% weekly ${q.week_pct}%`);
  }
  fs.writeFileSync(STATE, JSON.stringify({ ...q, read_at: now, cap_5h: CAP_5H, cap_week: CAP_WEEK, max_age_seconds: QUOTA_MAX_AGE_SECONDS, freshness: 'fresh' }) + '\n');
  const iso = t => t ? new Date(t * 1000).toISOString() : 'not started';
  log(`5h ${q.five_h_pct}% (reset ${iso(q.five_h_reset)}) weekly ${q.week_pct}% (reset ${iso(q.week_reset)})`);
} catch (e) {
  markSnapshotUnknown();
  log('zc-quota failed:', e.message); process.exitCode = 1;
} finally {
  ws.close();
  setTimeout(() => process.exit(), 1000);  // a hung peer never finishes the close handshake
}
