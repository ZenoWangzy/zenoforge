#!/usr/bin/env bash
# Run one coding agent on Codex luna by default, with ZCode (GLM-5.3, bin/zc) as failover.
# Same interface as luna: worker <key> <cwd> <prompt-file> [output-schema.json]
# Every backend reports in .scratch/luna/<key>/ (last.md = the final JSON, rc, backend). WORKER_BACKEND=luna|zc
# selects the initial backend; a health failure can still fail over once. WORKER_STALL_MINUTES defaults to 10.
# ZF_WORKER_HOST selects the host (default local); otherwise ZF_WORKER_HOSTS is probed in order for Luna runs.
# WORKER_GATE_QUEUE_SECONDS is for callers outside the engine; supervisor zf-launch sets 21600 after this merges.
# Engine units never set it.
# A backend that never passes the capacity gate fails after LUNA_AGE_ADMIT_SECONDS + the stall bound (rc=75, no failover: both backends share the gate).
# Both backends share luna's capacity gate (LUNA_MAX runs in total, started only while CPU < 85%).
set -uo pipefail
# Keep the complete body in one block so a live invocation has parsed it before this file is atomically replaced.
{
key="$1" cwd="$2" prompt="$3" schema="${4:-}"
B=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P) # backends ship beside this script, not in the scratch root
# Quota markers live in the agent home. Read it from deploy.env in a subshell: its other exports must not reach the agents.
hold_home=${AGENT_HOME:-${ZF_HOME:-$( [[ -f $B/../deploy.env ]] && (source "$B/../deploy.env" >/dev/null 2>&1; printf '%s' "${AGENT_HOME:-${ZF_HOME:-}}") )}}
hold_home=${hold_home:-$HOME/.zenoforge}
[[ -f $prompt ]] || { echo "worker: prompt file not found: ${prompt:0:80}" >&2; exit 2; }  # 10-31: brief text passed as a path; workers exited silently
if [[ -n ${HOME:-} ]]; then
  case "$prompt" in
    "$HOME"/.zenoforge/briefs/*|"$HOME"/.zenoforge/state/work/briefs/*)
      grep -Eq '^Existing path: .{8,}' "$prompt" || {
        printf '%s\n' 'worker: brief lacks "Existing path: <file:line of how main already handles the nearest sibling case>" (or "Existing path: none, <why>")' >&2
        exit 2
      }
      ;;
  esac
fi
S=${WORKER_SCRATCH_ROOT:-${HOME:-/tmp}/.zenoforge/scratch}; d="$S/luna/$key"
mkdir -p "$S/tmp" "$d"
model=${CODEX_MODEL:-gpt-6-luna}
round_model=$model
model_fallback=''
trap 'round_rc=$?
  [[ -z $model_fallback ]] || printf "%s\n" "$model_fallback" >> "$d/stderr.log"
  printf "%s %s %s rc=%s\n" "$(date -u +%FT%TZ)" "$key" "$round_model" "$round_rc" >> "$S/luna/rounds.log"
' EXIT
model_not_found_cache="$S/luna/model-not-found.cache"
model_not_found_cached() {
  local candidate=$1 now
  [[ -r $model_not_found_cache ]] || return 1
  now=$(date +%s)
  awk -F '\t' -v candidate="$candidate" -v now="$now" \
    '$1 == candidate && $2 ~ /^[0-9]+$/ && $2 > now { found=1 } END { exit !found }' "$model_not_found_cache"
}
cache_model_not_found() {
  local candidate=$1 now expires temp lock_fd
  [[ $candidate =~ ^[A-Za-z0-9._-]+$ ]] || return 0
  now=$(date +%s); expires=$((now + 86400))
  exec {lock_fd}>"$S/tmp/model-not-found-cache.lock"
  flock "$lock_fd"
  temp="$model_not_found_cache.$$"
  if [[ -f $model_not_found_cache ]]; then
    awk -F '\t' -v now="$now" -v candidate="$candidate" \
      '$1 ~ /^[A-Za-z0-9._-]+$/ && $2 ~ /^[0-9]+$/ && $2 > now && $1 != candidate { print $1 "\t" $2 }' \
      "$model_not_found_cache" > "$temp"
  else
    : > "$temp"
  fi
  printf '%s\t%s\n' "$candidate" "$expires" >> "$temp"
  mv "$temp" "$model_not_found_cache"
  flock -u "$lock_fd"
  exec {lock_fd}>&-
}
# 11-13 23:06Z: a codex_core::tools::router error echoes the patch the worker was writing on its continuation lines; that
# patch said "API rate limit already exceeded" and the worker was failed over as a quota error. Drop such an entry up to the
# next timestamped line before matching.
fatal_stderr_without_model_refresh() {
  awk '/^[0-9]{4}-[0-9]{2}-[0-9]{2}T/ { skip = ($0 ~ /codex_core::tools::router/) } !skip' "$1" 2>/dev/null \
    | grep -ivE 'codex_models_manager.*failed to refresh available models' || true
}
# Use the last numeric group: go3-3861 and review-3861 refer to the same ticket.
if [[ -f $S/luna/rounds.log ]] && awk -v key="$key" '
  function ticket(k) { sub(/[^0-9]*$/, "", k); sub(/^.*[^0-9]/, "", k); return k }
  BEGIN { wanted = ticket(key) }
  wanted != "" && ticket($2) == wanted && $4 ~ /^rc=[0-9]+$/ && $4 != "rc=0" { failed++ }
  END { exit !(failed >= 2) }
' "$S/luna/rounds.log"; then
  model_not_found_cached gpt-6.1-terra || model=gpt-6.1-terra  # maintainer 10-29: no sol, escalate unless cached unsupported
fi
b=${WORKER_BACKEND:-}  # 10-28: zc's 84% failure was our wrapper (json output, Built-in fatal), fixed
inflight() { local n=0 f; for f in "$S"/luna/*/backend; do [[ $(cat "$f" 2>/dev/null) == "$1" && ! -f ${f%/backend}/rc ]] && n=$((n+1)); done; echo "$n"; }
# config.sh exports ZF_CONFIG_ROOT and more; resolve in a subshell so none of it reaches the agents
mapfile -t zc_argv < <(source "$B/../config.sh" >/dev/null 2>&1 && zf_zcode_bin_argv)
zc_executable=${zc_argv[0]:-$S/zc-src/bin/zcode}
zc_configured=0; ((${#zc_argv[@]})) && zc_configured=1
zc_probe_rc=0
# 11-21 queue 884: a cached failed probe expires when the executable changed after the probe was written (a reinstall
# must not misroute until the next boot) or when the probe is older than 300 s (a package unpack can keep the archive's
# mtimes, so a reinstall can leave the executable older than the cache); a cached success stands for the whole boot.
# argv[0] is absolute in every resolution mode, so its mtime is the reinstall signal.
zc_probe_expired() {
  local exe_mtime cache_mtime
  cache_mtime=$(stat -c %Y "$1" 2>/dev/null) || return 1
  (( $(date +%s) - cache_mtime > 300 )) && return 0
  exe_mtime=$(stat -c %Y "$zc_executable" 2>/dev/null) || return 1
  (( exe_mtime > cache_mtime ))
}
zc_runnable() {
  local boot_id argv_key cache="$S/tmp/zc-runnable" alerts lock_fd
  local -a probe_argv=() cached=()
  probe_argv=("${zc_argv[@]}")
  boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || boot_id=unknown
  if ((${#probe_argv[@]})); then printf -v argv_key '%q ' "${probe_argv[@]}"; else argv_key='<unresolved>'; fi
  # Workers share this cache; serialize the probe and its once-per-boot alert.
  exec {lock_fd}>>"$cache"
  flock "$lock_fd"
  mapfile -t cached < "$cache"
  if ((${#cached[@]} == 3)) && [[ ${cached[0]} == "$boot_id" && ${cached[1]} == "$argv_key" && ${cached[2]} =~ ^[0-9]+$ ]] &&
    { (( ${cached[2]} == 0 )) || ! zc_probe_expired "$cache"; }; then
    zc_probe_rc=${cached[2]}
  else
    if ((${#probe_argv[@]})); then
      if timeout 10 "${probe_argv[@]}" --version >/dev/null 2>&1; then zc_probe_rc=0; else zc_probe_rc=$?; fi
    else
      zc_probe_rc=127
    fi
    printf '%s\n%s\n%s\n' "$boot_id" "$argv_key" "$zc_probe_rc" > "$cache"
  fi
  if (( zc_probe_rc != 0 && zc_configured )); then
    alerts="$hold_home/logs/head-watch.alerts"
    mkdir -p "${alerts%/*}" 2>/dev/null || true
    if ! grep -Fq "WORKER-ZCODE-UNRUNNABLE boot_id=$boot_id " "$alerts" 2>/dev/null; then
      printf '%s WORKER-ZCODE-UNRUNNABLE boot_id=%s command=%s probe_rc=%s\n' \
        "$(date -u +%FT%TZ)" "$boot_id" "$argv_key" "$zc_probe_rc" >> "$alerts" 2>/dev/null || true
    fi
  fi
  flock -u "$lock_fd"
  exec {lock_fd}>&-
  (( zc_probe_rc == 0 ))
}
zc_unavailable_reason() { printf 'zcode executable not runnable: %s (probe rc=%s)' "$zc_executable" "$zc_probe_rc"; }
breaker_path() { [[ $1 == zc ]] && echo "$S/tmp/zc-breaker" || echo "$S/tmp/luna-breaker"; }
# 11-21 queue 899: a quota or availability hold with its reason, or nothing. Head owns the marker files; the breaker
# file below is any worker's verdict on a transient failure, so it never appears here. One helper, both backends.
hold_reason() {
  if [[ $1 == zc ]]; then
    zc_runnable || { zc_unavailable_reason; return 0; }
    # 10-30 maintainer: bin/zc-quota holds ZCode before the 5h window runs out; same marker lib.sh's provider_quota_exhausted reads.
    (( $(cat "$hold_home/zcode-exhausted-until" 2>/dev/null || echo 0) > $(date +%s) )) && { echo 'zcode quota hold active'; return 0; }
  else
    (( $(cat "$hold_home/codex-exhausted-until" 2>/dev/null || echo 0) > $(date +%s) )) && { echo 'codex quota hold active'; return 0; }
    (( $(cat "$hold_home/codex-unavailable-until" 2>/dev/null || echo 0) > $(date +%s) )) && { echo 'codex unavailable hold active'; return 0; }
  fi
  return 1
}
breaker_open_for() {
  local file now touched
  hold_reason "$1" >/dev/null && return 0
  file=$(breaker_path "$1"); [[ -f $file ]] || return 1
  now=$(date +%s); touched=$(stat -c %Y "$file" 2>/dev/null) || return 1
  (( now - touched < ${WORKER_BREAKER_SECONDS:-1800} ))
}
if [[ -z $b ]]; then
  zc_open=0; luna_open=0
  breaker_open_for zc && zc_open=1
  breaker_open_for luna && luna_open=1
  if (( zc_open && !luna_open )); then
    b=luna
    if ! zc_runnable; then
      printf 'worker: %s; using luna instead of zc\n' "$(zc_unavailable_reason)" >&2
    fi
  elif (( luna_open && !zc_open )); then b=zc
  else
    # 10-28: both quotas reset; spread load so neither provider hits its weekly cap first (zc-only burned GLM's in ~1 h)
    exec {lk}>"$S/tmp/worker-pick.lock"; flock "$lk"
    l=$(inflight luna) z=$(inflight zc)
    if (( z < l )); then b=zc; elif (( l < z )); then b=luna
    else [[ $(cat "$S/tmp/worker-last" 2>/dev/null) == zc ]] && b=luna || b=zc; fi
    echo "$b" > "$S/tmp/worker-last"
    flock -u "$lk"; exec {lk}>&-
  fi
fi
if [[ $b == zc ]] && breaker_open_for zc; then
  zc_hold=$(hold_reason zc || true)
  if [[ -z $zc_hold ]]; then
    # 11-21 queue 899: an open breaker file alone is another task's verdict on a transient failure; the requested backend runs.
    printf '[%s] backend=zc kept; reason=zc breaker file only, no quota or availability hold\n' "$(date -u +%FT%TZ)" >> "$d/placement.log"
  elif luna_hold=$(hold_reason luna); then
    rm -f "$d/failover"
    printf '[%s] backend=zc skipped; reason=%s\n' "$(date -u +%FT%TZ)" "$zc_hold" >> "$d/failover"
    printf '[%s] backend=luna skipped; reason=%s\n' "$(date -u +%FT%TZ)" "$luna_hold" >> "$d/failover"
    final_reason="both backends held: zc: $zc_hold; luna: $luna_hold"
    printf '[%s] rc=75 reason=%s\n' "$(date -u +%FT%TZ)" "$final_reason" >> "$d/failover"
    printf 'worker: %s\n' "$final_reason" >&2
    echo 75 > "$d/rc"; exit 75
  else
    b=luna
    # 11-21 queue 884: <run>/backend says luna; the run directory must also say why the requested zc run never started.
    printf '[%s] backend=zc rerouted to luna; reason=%s\n' "$(date -u +%FT%TZ)" "$zc_hold" >> "$d/placement.log"
    printf 'worker: %s; using luna instead of zc\n' "$zc_hold" >&2
  fi
fi
if [[ $b != luna && $b != zc ]]; then
  printf 'worker: unsupported backend %s\n' "$b" >&2; echo 2 > "$d/rc"; exit 2
fi
rm -f "$d/rc" "$d/failover"
echo "$b" > "$d/backend"

stall_after=${WORKER_STALL_SECONDS:-}
if [[ -z $stall_after ]]; then
  stall_minutes=${WORKER_STALL_MINUTES:-10}
  if [[ ! $stall_minutes =~ ^[0-9]+$ ]]; then
    printf 'worker: WORKER_STALL_MINUTES must be an integer\n' >&2; echo 2 > "$d/rc"; exit 2
  fi
  stall_after=$((stall_minutes * 60))
fi
health_interval=${WORKER_HEALTH_INTERVAL_SECONDS:-2}
# The gate relaxes its CPU target after LUNA_AGE_ADMIT_SECONDS; still queued one stall bound later means memory or slots, not load.
age_admit=${LUNA_AGE_ADMIT_SECONDS:-1200}
if [[ ! $age_admit =~ ^[0-9]+$ || ! $stall_after =~ ^[0-9]+$ || ! $health_interval =~ ^[0-9]+([.][0-9]+)?$ || $health_interval == 0 || $health_interval == 0.0 ]]; then
  printf 'worker: invalid health timeout or interval\n' >&2; echo 2 > "$d/rc"; exit 2
fi
queue_after=$((age_admit + stall_after))
gate_queue_seconds=${WORKER_GATE_QUEUE_SECONDS:-}
if [[ $gate_queue_seconds =~ ^[1-9][0-9]{0,6}$ ]]; then
  queue_after=$((10#$gate_queue_seconds))
fi

worktree_state() {
  local status head
  status=$(git -C "$cwd" status --porcelain 2>/dev/null) || status='!git-status-unavailable'
  head=$(git -C "$cwd" rev-parse HEAD 2>/dev/null) || head='!git-head-unavailable'
  printf '%s\n%s' "$status" "$head"
}
file_state() {
  local size
  [[ -e $1 ]] || { printf 'missing'; return; }
  size=$(stat -c %s "$1" 2>/dev/null) || { printf 'missing'; return; }
  (( size > 0 )) || { printf 'empty'; return; }
  stat -c '%s:%y' "$1" 2>/dev/null || printf 'missing'
}
# 11-21 queue 899: the next attempt overwrites the logs, so the line behind a fatal verdict is kept on disk for the
# failover file to quote: first 300 characters, with the log file's name.
record_fatal_evidence() { printf '[%s] evidence=%s: %.300s\n' "$(date -u +%FT%TZ)" "${1##*/}" "$2" > "$d/fatal-evidence"; }
quote_fatal_evidence() { [[ -s $d/fatal-evidence ]] && cat "$d/fatal-evidence" >> "$d/failover"; return 0; }
fatal_reason() {
  local log match count
  for log in "$d/stderr.log" "$d/backend-run.stderr.log"; do
    [[ -f $log ]] || continue
    # -m1 (not -q) so the matching line survives the pipefail-SIGPIPE race: the captured text decides, not the status.
    match=$(fatal_stderr_without_model_refresh "$log" | grep -iEm1 'authentication failed|authentication[_ -]error|auth[_ -]error|unauthorized|not[[:space:]]+authorized|invalid[_ -]api[_ -]key|incorrect.{0,20}api key|api key.{0,40}(invalid|not valid|expired|incorrect)|invalid[_ -]token|token.{0,30}(invalid|expired)|insufficient[_ -]quota|quota.{0,20}(exceeded|exhausted|limit)|exceeded.{0,20}quota|billing.{0,30}(disabled|limit|exceeded)|payment required|resource[_ -]exhausted|rate[_ -]limit|(^|[^0-9])(401|403|429)([^0-9]|$)|too many requests' || true)
    if [[ -n $match ]]; then
      record_fatal_evidence "$log" "$match"
      echo 'fatal stderr pattern: authentication or quota error'; return 0
    fi
    # 10-28 factory-mainfix r1: zc's terminal `Error: Turn execution failed` (events.jsonl closes with turn.failed)
    # exits rc=1 with no last.md; fail over to the other backend on the same dirty worktree instead of ending the round.
    match=$(fatal_stderr_without_model_refresh "$log" | grep -iFm1 'Turn execution failed' || true)
    if [[ -n $match ]]; then
      record_fatal_evidence "$log" "$match"
      echo 'fatal stderr pattern: Turn execution failed'; return 0
    fi
  done
  match=''
  [[ -f $d/events.jsonl ]] && match=$(grep -Eim1 '"type"[[:space:]]*:[[:space:]]*"turn\.failed"' "$d/events.jsonl" || true)
  if [[ -n $match ]] && grep -Eiq 'authentication[_ -]error|authentication failed|auth[_ -]error|unauthorized|not[[:space:]]+authorized|invalid[_ -]token|token.{0,30}(invalid|expired)|(^|[^0-9])(401|403|429)([^0-9]|$)' "$d/events.jsonl"; then
    record_fatal_evidence "$d/events.jsonl" "$match"
    echo 'fatal event pattern: turn.failed'; return 0
  fi
  count=$(
    for log in "$d/stderr.log" "$d/backend-run.stderr.log"; do
      [[ -f $log ]] || continue
      fatal_stderr_without_model_refresh "$log" | grep -ic 'AI_APICallError' || true
    done | awk '{ n += $1 } END { print n+0 }'
  )
  if (( count >= 2 )); then
    match=$(fatal_stderr_without_model_refresh "$d/stderr.log" | grep -im1 'AI_APICallError' || true)
    [[ -n $match ]] && record_fatal_evidence "$d/stderr.log" "$match"
    echo "fatal stderr pattern: repeated AI_APICallError ($count occurrences)"; return 0
  fi
  return 1
}
# 11-21 queue 899: all zcode processes on a host share one sqlite database; ERR_SQLITE_ERROR "database is locked" is
# transient contention between them, not a provider failure. The code is read from the turn.failed event itself,
# never from a text grep of the whole log.
locked_db_failure() {
  local failed
  [[ -f $d/events.jsonl ]] || return 1
  failed=$(grep -E '"type"[[:space:]]*:[[:space:]]*"turn\.failed"' "$d/events.jsonl" 2>/dev/null || true)
  [[ -n $failed ]] || return 1
  # No -q: grep reads all of $failed, so printf can never die on SIGPIPE under pipefail.
  printf '%s' "$failed" | grep -E '"code"[[:space:]]*:[[:space:]]*"ERR_SQLITE_ERROR"' >/dev/null &&
    printf '%s' "$failed" | grep -E '"message"[[:space:]]*:[[:space:]]*"database is locked"' >/dev/null
}
stderr_has_meaningful_delta() {
  local file=$1 previous=$2 current delta
  [[ -f $file ]] || return 1
  current=$(stat -c %s "$file" 2>/dev/null) || return 1
  (( current > previous )) || return 1
  delta=$(tail -c +$((previous + 1)) "$file" 2>/dev/null || true)
  if [[ -n $delta ]] && printf '%s' "$delta" | grep -Eivq 'skipped[[:space:]]*\(not-due\)|^ZCode Built-in '; then return 0; fi
  return 1
}
stop_backend_group() {
  local pid=$1 i
  # pid is the session/process-group leader saved by this wrapper, never discovered by process-name scans.
  kill -TERM -- "-$pid" 2>/dev/null || true
  for ((i=0; i<10; i++)); do
    kill -0 -- "-$pid" 2>/dev/null || return 0
    sleep 0.1
  done
  kill -KILL -- "-$pid" 2>/dev/null || true
}
run_reason=''
run_rc=0
run_queued=0
run_backend() {
  local backend=$1 pid backend_pid last_activity now progress run_started current_worktree previous_worktree
  local events_state last_state previous_events previous_last stderr_offset=0 stdout_offset=0 wrapper_stderr_offset=0
  local monitor_reason='' should_stop=0 group_pid zc_prompt="$S/tmp/$key.zc-prompt.md"
  local attempt_prev attempt_stamp
  local -a backend_cmd
  run_reason=''; run_rc=0; run_queued=0; run_started=$(date +%s)
  echo "$backend" > "$d/backend"
  # Keep the previous attempt's logs: 10-29 a failover wiped the zc-stage events that held the only record of who edited
  # live state; 11-21 queue 899 keeps its stderr too, because the line behind the verdict must survive the next attempt.
  attempt_prev=$(cat "$d/attempt-backend" 2>/dev/null || echo prev); attempt_stamp=$(date -u +%H%M%S)
  [[ -s $d/events.jsonl ]] && mv "$d/events.jsonl" "$d/events.$attempt_prev.$attempt_stamp.jsonl"
  [[ -s $d/stderr.log ]] && mv "$d/stderr.log" "$d/stderr.$attempt_prev.$attempt_stamp.log"
  [[ -s $d/backend-run.stderr.log ]] && mv "$d/backend-run.stderr.log" "$d/backend-run.stderr.$attempt_prev.$attempt_stamp.log"
  echo "$backend" > "$d/attempt-backend"
  rm -f "$d/rc" "$d/codex.pid" "$d/backend-run.pid" "$d/last.md" "$d/gate-wait" "$d/fatal-evidence" \
    "$d/stderr.log" "$d/backend-run.stdout.log" "$d/backend-run.stderr.log"
  previous_worktree=$(worktree_state)
  previous_events=$(file_state "$d/events.jsonl")
  previous_last=$(file_state "$d/last.md")
  last_activity=$(date +%s)
  if [[ $backend == zc ]]; then
    round_model=GLM-5.3
    {
      cat "$prompt"
      [[ -n $schema ]] && printf '\n\nYour final message must be exactly one JSON object that matches this JSON Schema, with no prose and no code fence:\n%s\n' "$(cat "$schema")"
    } > "$zc_prompt"
    backend_cmd=(env ZC_OUT_ROOT="$S/luna" "$B/zc" "$key" "$cwd" "$zc_prompt")
  else
    round_model=$model
    worker_host=$(python3 "$B/worker-remote.py" choose 2>>"$d/placement.log") || worker_host=local
    [[ -n "$worker_host" ]] || worker_host=local
    backend_cmd=(env CODEX_MODEL="$model" ZF_WORKER_HOST="$worker_host" "$B/luna" "$key" "$cwd" "$prompt" "$schema")
  fi
  setsid --wait bash -c 'pid_file=$1; shift; printf "%s\n" "$$" > "$pid_file"; exec "$@"' \
    worker-session "$d/backend-run.pid" "${backend_cmd[@]}" \
    >"$d/backend-run.stdout.log" 2>"$d/backend-run.stderr.log" &
  pid=$!
  backend_pid=$pid
  trap 'stop_backend_group "$backend_pid"; exit 143' TERM INT HUP

  while kill -0 "$pid" 2>/dev/null; do
    # Builtin read, not $(cat): a TERM to the worker's group kills the substitution and would blank backend_pid, so the TERM trap would signal no group and orphan the backend.
    [[ ! -s $d/backend-run.pid ]] || { read -r group_pid < "$d/backend-run.pid" && [[ $group_pid =~ ^[0-9]+$ ]] && backend_pid=$group_pid; } || true
    monitor_reason=$(fatal_reason || true)
    if [[ -n $monitor_reason ]]; then should_stop=1; break; fi
    now=$(date +%s); progress=0
    current_worktree=$(worktree_state)
    [[ $current_worktree == "$previous_worktree" ]] || progress=1
    previous_worktree=$current_worktree
    events_state=$(file_state "$d/events.jsonl")
    last_state=$(file_state "$d/last.md")
    if [[ $events_state != "$previous_events" || $last_state != "$previous_last" ]]; then progress=1; fi
    previous_events=$events_state; previous_last=$last_state
    stderr_has_meaningful_delta "$d/stderr.log" "$stderr_offset" && progress=1
    stderr_has_meaningful_delta "$d/backend-run.stdout.log" "$stdout_offset" && progress=1
    stderr_has_meaningful_delta "$d/backend-run.stderr.log" "$wrapper_stderr_offset" && progress=1
    stderr_offset=$(stat -c %s "$d/stderr.log" 2>/dev/null || echo "$stderr_offset")
    stdout_offset=$(stat -c %s "$d/backend-run.stdout.log" 2>/dev/null || echo "$stdout_offset")
    wrapper_stderr_offset=$(stat -c %s "$d/backend-run.stderr.log" 2>/dev/null || echo "$wrapper_stderr_offset")
    if (( progress )); then last_activity=$now; fi
    # Backends write codex.pid only once past the shared capacity gate; queueing there is not a stall (w3 was killed 2026-10-26).
    if [[ ! -s $d/codex.pid ]]; then
      last_activity=$now
      if (( now - run_started >= queue_after )); then
        monitor_reason="queued at the capacity gate for ${queue_after}s: no backend process started (codex.pid absent; see gate-wait)"
        run_queued=1; should_stop=1; break
      fi
    fi
    if (( now - last_activity >= stall_after )); then
      monitor_reason="no progress for ${stall_after}s: events/output unchanged and git status --porcelain plus HEAD unchanged"
      should_stop=1; break
    fi
    sleep "$health_interval"
  done
  if (( should_stop )) && kill -0 "$pid" 2>/dev/null; then
    group_pid=$(cat "$d/backend-run.pid" 2>/dev/null || true)
    [[ $group_pid =~ ^[0-9]+$ ]] && stop_backend_group "$group_pid"
  fi
  wait "$pid"; run_rc=$?
  trap - TERM INT HUP
  rm -f "$d/backend-run.pid"
  if [[ $backend == luna ]] && grep -qiF 'model_not_found' "$d/events.jsonl" 2>/dev/null; then
    cache_model_not_found "$round_model"
  fi
  if [[ -n $monitor_reason ]]; then run_reason=$monitor_reason
  else run_reason=$(fatal_reason || true); fi
  printf '%s\n' "$run_rc" > "$d/rc"
}

run_with_model_fallback() {
  local backend=$1 from to
  run_backend "$backend"
  if [[ $backend == luna && $run_rc != 0 ]] && grep -Fq 'Selected model is at capacity' "$d/events.jsonl" 2>/dev/null; then
    from=$model
    case $model in
      gpt-6.1-terra|gpt-6.1-sol) model=gpt-6-luna; to=default ;;  # maintainer 10-29: no sol
      *) return ;;
    esac
    # Backends replace stderr.log; append this at worker exit, even if health failover follows.
    model_fallback="model-fallback $from -> $to"
    run_backend luna
  fi
}

# The next attempt starts with no memory of this one: 10-29 #4486 opened a second PR for the same ticket after failover.
resume_prompt_for() { # reason -> prompt becomes the resume prompt for the next attempt
  local resume="$S/tmp/$key.resume.md"
  { cat "$prompt"; printf '\n## Resume after backend failover\nAnother agent already worked in this worktree and stopped (%s). Before doing anything else, read `git status`, `git log origin/main..HEAD` and `gh pr list --head "$(git branch --show-current)" --state open`. Continue from that state: reuse the existing commits and PR, and push to the same branch.\n' "$1"; } > "$resume"
  prompt=$resume
}

# A queue timeout is the gate's state, not the provider's: no breaker, no failover (the other backend waits at the same gate).
queue_fail() {
  printf '[%s] backend=%s not started; reason=%s\n' "$(date -u +%FT%TZ)" "$1" "$run_reason" >> "$d/failover"
  printf '[%s] rc=75 reason=%s\n' "$(date -u +%FT%TZ)" "$run_reason" >> "$d/failover"
  printf 'worker: %s\n' "$run_reason" >&2
  echo 75 > "$d/rc"; exit 75
}
run_with_model_fallback "$b"
(( run_queued )) && queue_fail "$b"
final_backend=$b
if [[ -n $run_reason ]]; then
  failed_backend=$b; first_reason=$run_reason
  if [[ $failed_backend == zc ]] && locked_db_failure; then
    # No breaker, no luna: wait out the lock (5 s for the lock holder, then 15 s more for the queue behind it) and
    # retry zc once in the same clone with the resume prompt; a second locked failure ends rc=75.
    printf '[%s] backend=zc failed; reason=%s; locked database: waiting to retry zc\n' "$(date -u +%FT%TZ)" "$first_reason" >> "$d/failover"
    quote_fatal_evidence
    resume_prompt_for "$first_reason"
    sleep 5; sleep 15
    run_with_model_fallback zc
    (( run_queued )) && queue_fail zc
    final_backend=zc
    if [[ -n $run_reason ]]; then
      printf '[%s] backend=zc failed; reason=%s; locked database twice: giving up\n' "$(date -u +%FT%TZ)" "$run_reason" >> "$d/failover"
      quote_fatal_evidence
      final_reason="both backends failed: zc: $first_reason; zc retry after locked database: $run_reason"
      printf '[%s] rc=75 reason=%s\n' "$(date -u +%FT%TZ)" "$final_reason" >> "$d/failover"
      printf '%s\n' "$final_reason" >&2
      echo 75 > "$d/rc"; exit 75
    fi
    if (( run_rc != 0 )); then
      final_reason="both backends failed: zc: $first_reason; zc retry after locked database exited rc=$run_rc"
      printf '[%s] backend=zc failed; rc=%s\n' "$(date -u +%FT%TZ)" "$run_rc" >> "$d/failover"
      printf '[%s] rc=75 reason=%s\n' "$(date -u +%FT%TZ)" "$final_reason" >> "$d/failover"
      printf '%s\n' "$final_reason" >&2
      echo 75 > "$d/rc"; exit 75
    fi
  fi
  if [[ -n $run_reason ]]; then
    touch "$(breaker_path "$failed_backend")"
    next_backend=luna; [[ $failed_backend == luna ]] && next_backend=zc
    printf '[%s] backend=%s failed; next=%s; reason=%s\n' "$(date -u +%FT%TZ)" "$failed_backend" "$next_backend" "$first_reason" >> "$d/failover"
    quote_fatal_evidence
    resume_prompt_for "$first_reason"
    # 11-21 queue 899: a quota or availability hold stops the move in either direction; the next backend's short
    # breaker file alone does not (it is another task's verdict, not a hold on this provider).
    next_hold=$(hold_reason "$next_backend" || true)
    if [[ -n $next_hold ]]; then
      printf '[%s] backend=%s skipped; reason=%s\n' "$(date -u +%FT%TZ)" "$next_backend" "$next_hold" >> "$d/failover"
      final_reason="both backends failed: $failed_backend: $first_reason; $next_backend: $next_hold"
      printf '[%s] rc=75 reason=%s\n' "$(date -u +%FT%TZ)" "$final_reason" >> "$d/failover"
      printf '%s\n' "$final_reason" >&2
      echo 75 > "$d/rc"; exit 75
    fi
    run_with_model_fallback "$next_backend"
    (( run_queued )) && queue_fail "$next_backend"
    final_backend=$next_backend
    if [[ -n $run_reason ]]; then
      second_reason=$run_reason
      touch "$(breaker_path "$next_backend")"
      printf '[%s] backend=%s failed; reason=%s\n' "$(date -u +%FT%TZ)" "$next_backend" "$second_reason" >> "$d/failover"
      quote_fatal_evidence
      final_reason="both backends failed: $failed_backend: $first_reason; $next_backend: $second_reason"
      printf '[%s] rc=75 reason=%s\n' "$(date -u +%FT%TZ)" "$final_reason" >> "$d/failover"
      printf '%s\n' "$final_reason" >&2
      echo 75 > "$d/rc"; exit 75
    fi
    if (( run_rc != 0 )); then
      final_reason="both backends failed: $failed_backend: $first_reason; $next_backend exited rc=$run_rc"
      printf '[%s] backend=%s failed; rc=%s\n' "$(date -u +%FT%TZ)" "$next_backend" "$run_rc" >> "$d/failover"
      printf '[%s] rc=75 reason=%s\n' "$(date -u +%FT%TZ)" "$final_reason" >> "$d/failover"
      printf '%s\n' "$final_reason" >&2
      echo 75 > "$d/rc"; exit 75
    fi
  fi
fi
final_rc=$run_rc
echo "$final_rc" > "$d/rc"
if [[ $final_backend == zc && -n $schema && -s $d/last.md ]]; then python3 - "$d/last.md" <<'EOF'
import json, sys
p = sys.argv[1]; t = open(p).read(); dec = json.JSONDecoder(); found = None; i = t.find('{')
while i != -1:
    try:
        o, end = dec.raw_decode(t, i)
        if isinstance(o, dict): found = o
        i = t.find('{', end)
    except ValueError:
        i = t.find('{', i + 1)
if found is not None:
    open(p + '.raw', 'w').write(t); open(p, 'w').write(json.dumps(found, ensure_ascii=False))
EOF
fi
exit "$final_rc"
}
