#!/usr/bin/env bash
# Run one ZCode (Z.ai) agent non-interactively, the same lane shape as luna.
# Usage: zc <key> <cwd> <prompt-file>
# Writes .scratch/zc/<key>/{last.md,events.jsonl,stderr.log,rc} plus wrapper.pid and codex.pid (the worker pid; name kept for health-watch).
# A remote ZF_WORKER_HOST hands the run to worker-remote.py first (shared hand-off with luna); a refusal runs locally.
# ZC_MODE (default yolo) maps to `zcode --mode`; yolo is not a sandbox, same trust level as luna's danger-full-access.
# The worker is the ZCode Node bundle run through a copy of node named `zcode`, so its comm is `zcode-cli` (ZCode renames its own process title).
set -uo pipefail
unset GH_TOKEN GITHUB_TOKEN
# Whole body is one { ... } block (see luna): replace this file atomically with a temp file + mv, never edit in place.
{
key="$1" cwd="$2" prompt="$3"
B=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P) # as bin/worker: the hold marker is read the same way
hold_home=${AGENT_HOME:-${ZF_HOME:-$( [[ -f $B/../deploy.env ]] && (source "$B/../deploy.env" >/dev/null 2>&1; printf '%s' "${AGENT_HOME:-${ZF_HOME:-}}") )}}
hold_home=${hold_home:-$HOME/.zenoforge}
# Founder ruling glm_factory_hold_until_reset_2026_11_09: no factory ZCode start while the marker is in the future (bin/worker checks it too).
held_until=$(cat "$hold_home/zcode-exhausted-until" 2>/dev/null || echo 0)
if (( held_until > $(date +%s) )) && [[ "${ZC_IGNORE_HOLD:-0}" != 1 ]]; then
  echo "zc: ZCode held until $(date -u -d "@$held_until" +%FT%TZ) (zcode-exhausted-until); set ZC_IGNORE_HOLD=1 to override" >&2
  exit 75
fi
root=${WORKER_SCRATCH_ROOT:-${HOME:-/tmp}/.zenoforge/scratch}
agent_sandbox="$B/agent-sandbox-run"
out="${ZC_OUT_ROOT:-$root/zc}/$key"   # bin/worker sets ZC_OUT_ROOT=.scratch/luna so every backend reports in one place
mkdir -p "$out" "$root/tmp/$key"
rm -f "$out/rc" "$out/codex.pid"; echo $$ >"$out/wrapper.pid"   # health-watch reads these
run_cwd="$cwd"; [[ "$run_cwd" == /* ]] || run_cwd="$PWD/$run_cwd"; printf '%s\n' "$run_cwd" >"$out/cwd"
# Shared with bin/luna (lib.d/worker-remote-handoff.sh): a remote run exits there; a refusal falls back to the local gate below.
source "$B/../lib.d/worker-remote-handoff.sh"
worker_remote_handoff zc "$out" "$key" "$cwd" "$prompt"
source "$B/luna-capacity.sh"
slots="${LUNA_SLOTS:-$root/tmp/luna-slots}"; mkdir -p "$slots"
# A run that cannot start yet publishes wait-<prio>-<pid> (prio = LUNA_PRIORITY, pid = this wrapper): the autopilot
# scheduler holds new ordinary workers while a hotfix/opt run queues here (#4621, maintainer 10-29 strict priority
# hotfix > opt > 普通 pipeline). Removed on start and on exit; a wrapper killed while waiting leaves a stale file
# that whoever sees next drops (the scheduler's higher_priority_waiting does the same check).
prio="${LUNA_PRIORITY:-normal}"; wait_f="$slots/wait-$prio-$$"
chain_exit_trap() {
  local cur prior
  if [[ "$BASHPID" != "$$" && "${chain_exit_trap_pid:-}" != "$BASHPID" ]]; then
    chain_exit_trap_pid=$BASHPID; trap "$1" EXIT # lint-exempt: first EXIT trap in a subshell
    return 0
  fi
  cur="$(trap -p EXIT)"
  eval "prior=$(sed -n 's/^trap -- //; s/ EXIT$//p' <<<"$cur")"
  trap "$1${prior:+; $prior}" EXIT # lint-exempt: preserve any existing exit trap
}
chain_exit_trap 'rm -f -- "$wait_f" "$out/gate-wait"; [[ -z "${scope:-}" ]] || systemctl --user stop "$scope.scope" >/dev/null 2>&1 || true'
if [[ ${ZF_WORKER_REMOTE_INNER:-0} != 1 ]]; then
  wait_attempt=0 gate_reload_at=""
  while :; do
    [[ -e "$wait_f" ]] || printf '%(%s)T\n' -1 >"$wait_f"
    [[ -e "$wait_f" ]] || { echo "zc: cannot publish capacity ticket $wait_f" >&2; exit 74; }
    if [[ ! "$gate_reload_at" =~ ^[0-9]+$ ]] || (( SECONDS - gate_reload_at >= ${LUNA_GATE_RELOAD_SECONDS:-60} )); then
      luna_reload_live_gate
      gate_reload_at=$SECONDS
    fi
    luna_reload_gate_env
    if declare -F luna_waiter_has_room >/dev/null; then
      if luna_waiter_has_room "$slots" "$wait_f" "$prio" "$SECONDS" zc; then break; fi
    elif box_has_room "$SECONDS" zc; then
      break
    fi
    [[ -e "$wait_f" ]] || { echo "zc: capacity ticket disappeared: $wait_f" >&2; exit 74; }
    [[ -f $out/gate-wait ]] || printf '%(%s)T\n' -1 >"$out/gate-wait"
    luna_wait_backoff "$wait_attempt"
    wait_attempt=$((wait_attempt + 1))
    luna_waiter_sleep "$slots" "$LUNA_WAIT_DELAY" || { echo 'zc: could not wait on capacity gate' >&2; exit 74; }
  done
else
  # Remote zc joins luna's inner shape: no local capacity gate, a validated zf-remote scope under
  # zf-remote.slice with its own CPU weight; the user-manager stop is chained so the next same-key run can recreate
  # the scope (the remote account is never root -- the placement probe refuses uid 0 -- and has linger on).
  scope="${ZF_WORKER_REMOTE_SCOPE_NAME:-}"
  [[ "$scope" =~ ^zf-remote-[A-Za-z0-9_-]+-[0-9a-f]{8}$ ]] || { echo 'zc: invalid remote scope name' >&2; exit 2; }
  # A user manager without a delegated cpu controller refuses CPUWeight: log one line and run without the weight.
  systemctl --user set-property --runtime zf-remote.slice "CPUWeight=${ZF_WORKER_REMOTE_CPU_WEIGHT:-20}" >/dev/null 2>&1 \
    || echo 'zc: could not set zf-remote.slice CPUWeight (running without it)' >&2
  chain_exit_trap 'systemctl --user stop "$scope.scope" >/dev/null 2>&1 || true'
  printf '%s\n' "$scope" >"$out/remote.scope"
fi
mapfile -t zcode_cmd < <(source "$B/../config.sh" >/dev/null 2>&1 && zf_zcode_bin_argv)
(( ${#zcode_cmd[@]} )) || { echo "zc: zcode executable missing (config engine.zcode_bin, ZCODE_BIN, zc-src, PATH)" >&2; echo 75 >"$out/rc"; exit 75; }
# MCP, plugins, skills, hooks and memory are switched off in ~/.zcode/cli/config.json (features.* = false).
# Node's fetch ignores HTTP(S)_PROXY unless NODE_USE_ENV_PROXY=1, and WSL reaches Z.ai only through the proxy.
# Own memory-capped scope, named luna-* so health-watch's memory relief covers it like a codex run.
# One CPU budget across agent runs (maintainer 10-29 [...]); shared with dispatch-codex.sh.
source "${ZF_ENGINE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}/thread-budget.sh" && agent_thread_budget
source "${ZF_ENGINE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}/lib.d/worker-output-cap.sh"
[[ ${ZF_WORKER_REMOTE_INNER:-0} == 1 ]] || scope="luna-zc-${key//[^A-Za-z0-9_-]/-}-$$"
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
mem_high="${LUNA_MEM_HIGH:-$(source "$B/../config.sh" >/dev/null 2>&1 && zf_worker_mem_cap mem_high)}"
mem_max="${LUNA_MEM_MAX:-$(source "$B/../config.sh" >/dev/null 2>&1 && zf_worker_mem_cap mem_max)}"
cpu_weight="${AGENT_WORKER_CPU_WEIGHT:-10}"
if [[ ${ZF_WORKER_REMOTE_INNER:-0} == 1 ]]; then cpu_weight="${ZF_WORKER_REMOTE_CPU_WEIGHT:-20}"
elif [[ "${LUNA_PRIORITY:-}" == hotfix ]]; then cpu_weight=1000; fi
# 11-22: one argv over 128 KB fails exec (E2BIG, exit 126); zcode reads a large prompt as an attached file.
prompt_args=(--prompt "$(<"$prompt")")
(( $(wc -c < "$prompt") < 120000 )) || prompt_args=(--prompt "The attached file is your complete task input; follow it exactly." --attach "$prompt")
systemd_args=(--user --scope --quiet --slice="${ZF_WORKER_SLICE:-zf-workers.slice}" --unit="$scope")
TMPDIR="$root/tmp/$key" PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/install-guard:$root/bin:$PATH" COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NODE_USE_ENV_PROXY=1 BASH_MAX_OUTPUT_LENGTH="$(worker_output_cap_chars)" \
  systemd-run "${systemd_args[@]}" -p MemoryHigh="${mem_high:-1536M}" -p MemoryMax="${mem_max:-2G}" -p CPUQuota="${LUNA_CPU_QUOTA:-${AGENT_WORKER_CPU_QUOTA:-200%}}" -p CPUWeight="$cpu_weight" -p TasksMax="${AGENT_WORKER_TASKS_MAX:-500}" -p MemorySwapMax=0 -p OOMPolicy=continue -- \
  "$agent_sandbox" zcode "${ZF_AGENT_ACCESS:-read}" "$run_cwd" "" -- \
  "${zcode_cmd[@]}" \
  "${prompt_args[@]}" --cwd "$run_cwd" --mode "${ZC_MODE:-yolo}" --output-format stream-json --no-color \
  >"$out/events.jsonl" 2>"$out/stderr.log" &
zpid=$!; echo "$zpid" >"$out/codex.pid"; sleep 3; rm -f -- "$wait_f" "$out/gate-wait"
# Sample the scope's memory.peak while it lives: systemd reaps the cgroup the moment the run ends (11-21: four
# ended runs had no scope dir left at a read after wait), so the peak must come from a read made during the run.
peak_sample="$root/tmp/$key/scope-peak.sample"
declare -F luna_watch_scope_peak >/dev/null 2>&1 && luna_watch_scope_peak "$scope" "$zpid" "$peak_sample" &
wait "$zpid"; rc=$?
# Record the last peak read while the scope lived; none readable at any time records nothing and leaves rc alone.
# A remote run has no local zf-workers scope (its zf-remote scope lives on the remote host), so it records no peak.
read -r peak_bytes < "$peak_sample" 2>/dev/null || peak_bytes=''
[[ ${ZF_WORKER_REMOTE_INNER:-0} == 1 ]] || { declare -F luna_record_scope_peak >/dev/null 2>&1 && luna_record_scope_peak zc "$scope" "$peak_bytes"; }
rm -f -- "$peak_sample"
# stream-json writes events as the run goes (json wrote one object at exit, so bin/worker saw no progress and killed
# 27 healthy zc runs at 600 s, 10-27); the closing {"type":"result"} line carries the same .response.
jq -Rr 'fromjson? | select(.type=="result") | .response // empty' "$out/events.jsonl" >"$out/last.md" 2>/dev/null
echo "$rc" >"$out/rc"
# EXIT cleanup also stops the scope if the wrapper is interrupted after launch.
exit "$rc"
}
