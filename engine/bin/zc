#!/usr/bin/env bash
# Run one ZCode (Z.ai) agent non-interactively, the same lane shape as luna.
# Usage: zc <key> <cwd> <prompt-file>
# Writes .scratch/zc/<key>/{last.md,events.jsonl,stderr.log,rc} plus wrapper.pid and codex.pid (the worker pid; name kept for health-watch).
# ZC_MODE (default yolo) maps to `zcode --mode`; yolo is not a sandbox, same trust level as luna's danger-full-access.
# The worker is the ZCode Node bundle run through a copy of node named `zcode`, so its comm is `zcode-cli` (ZCode renames its own process title).
set -uo pipefail
unset GH_TOKEN GITHUB_TOKEN
# Whole body is one { ... } block (see luna): replace this file atomically with a temp file + mv, never edit in place.
{
key="$1" cwd="$2" prompt="$3"
B=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P) # as bin/worker: the hold marker is read the same way
hold_home=${AGENT_HOME:-${ZF_HOME:-$( [[ -f $B/../deploy.env ]] && (source "$B/../deploy.env" >/dev/null 2>&1; printf '%s' "${AGENT_HOME:-${ZF_HOME:-}}") )}}
hold_home=${hold_home:-$HOME/.zenoforge}
# Founder ruling glm_factory_hold_until_reset_2026_11_09: no factory ZCode start while the marker is in the future (bin/worker checks it too).
held_until=$(cat "$hold_home/zcode-exhausted-until" 2>/dev/null || echo 0)
if (( held_until > $(date +%s) )) && [[ "${ZC_IGNORE_HOLD:-0}" != 1 ]]; then
  echo "zc: ZCode held until $(date -u -d "@$held_until" +%FT%TZ) (zcode-exhausted-until); set ZC_IGNORE_HOLD=1 to override" >&2
  exit 75
fi
root=${WORKER_SCRATCH_ROOT:-${HOME:-/tmp}/.zenoforge/scratch}
out="${ZC_OUT_ROOT:-$root/zc}/$key"   # bin/worker sets ZC_OUT_ROOT=.scratch/luna so every backend reports in one place
zsrc="$root/zc-src"
mkdir -p "$out" "$root/tmp/$key"
rm -f "$out/rc" "$out/codex.pid"; echo $$ >"$out/wrapper.pid"   # health-watch reads these
# Same capacity gate and mutex as luna. Runs = top-level codex processes + top-level zcode processes, so both lanes share LUNA_MAX.
slots="${LUNA_SLOTS:-$root/tmp/luna-slots}"; mkdir -p "$slots"
top_runs() { local c=$1 p n=0; for p in $(pgrep -x "$c"); do [[ "$(ps -o comm= -p "$(ps -o ppid= -p "$p" | tr -d ' ')" 2>/dev/null)" == "$c" ]] || n=$((n+1)); done; echo "$n"; }
codex_runs() { echo $(( $(top_runs codex) + $(top_runs zcode-cli) )); }
cpu_busy() { local a b; a=($(head -1 /proc/stat)); sleep 2; b=($(head -1 /proc/stat))
  local busy=$(( (b[1]+b[2]+b[3]+b[6]+b[7]+b[8]) - (a[1]+a[2]+a[3]+a[6]+a[7]+a[8]) )) idle=$(( (b[4]+b[5]) - (a[4]+a[5]) ))
  echo $(( 100 * busy / (busy + idle + 1) )); }
box_has_room() {  # maintainer bound: at most 10 agent runs, whatever LUNA_MAX a launcher sets (10-29 a launcher set 14 -> 17 agents)
  local runs avail cpu full
  runs=$(codex_runs)
  avail=$(awk '/^MemAvailable:/{print int($2/1024)}' "${LUNA_PROC_MEMINFO:-/proc/meminfo}")
  full=$(awk -F'avg10=' '/^full/{print int($2)}' "${LUNA_PROC_PSI_MEMORY:-/proc/pressure/memory}")
  (( runs < ${LUNA_MIN:-2} && avail >= 2048 )) && return 0
  # 2026-11-09: hotfix reads memory `full` (every non-idle task stalled at once = thrashing), not `some` (any task stalled;
  # it sat at ~32 on this box and never opened the gate). Floor 3 GB, as for the aging and CPU tiers.
  [[ "${LUNA_PRIORITY:-}" == hotfix ]] && (( avail >= 3072 && full < 10 )) && return 0
  # Aging (10-29): strict priority starved opt 25-31 min at CPU>85% while hotfix ran. A run that has waited
  # LUNA_AGE_ADMIT_SECONDS skips only the CPU target; CPUWeight 10 (AGENT_WORKER_CPU_WEIGHT) vs hotfix 1000 keeps it on leftover cycles.
  # 2026-11-09 measured baseline (152 luna scopes/3d): peak p50/p90/p99/max 468/1142/2252/3136 MB; MemAvailable p10/p50 4494/6830 MB (24h), so 5120 blocked ~20%.
  # PSI full avg60 p99/max 9.2/12.5 (24h); swap free 29.9/32 GB. Use p99 run peak 2252 MB + 1 GB session reserve, rounded to 3328 MB; full < 10 remains pressure guard.
  (( SECONDS >= ${LUNA_AGE_ADMIT_SECONDS:-1200} && runs < 10 && full < 10 && avail >= ${LUNA_ADMIT_AVAIL_MB:-3328} )) && return 0
  cpu=$(cpu_busy)
  (( runs < (${LUNA_MAX:-10} < 10 ? ${LUNA_MAX:-10} : 10) && cpu < ${LUNA_CPU_TARGET:-85} && full < 10 && avail >= ${LUNA_ADMIT_AVAIL_MB:-3328} ))
}
# A run that cannot start yet publishes wait-<prio>-<pid> (prio = LUNA_PRIORITY, pid = this wrapper): the autopilot
# scheduler holds new ordinary workers while a hotfix/opt run queues here (#4621, maintainer 10-29 strict priority
# hotfix > opt > 普通 pipeline). Removed on start and on exit; a wrapper killed while waiting leaves a stale file
# that whoever sees next drops (the scheduler's higher_priority_waiting does the same check).
prio="${LUNA_PRIORITY:-normal}"; wait_f="$slots/wait-$prio-$$"
wait_stale_drop() { local f p; for f in "$slots"/wait-*; do [[ -e "$f" ]] || continue; p="${f##*-}"; { [[ "$p" =~ ^[0-9]+$ ]] && kill -0 "$p" 2>/dev/null; } || rm -f -- "$f"; done; }
chain_exit_trap() {
  local cur prior
  if [[ "$BASHPID" != "$$" && "${chain_exit_trap_pid:-}" != "$BASHPID" ]]; then
    chain_exit_trap_pid=$BASHPID; trap "$1" EXIT # lint-exempt: first EXIT trap in a subshell
    return 0
  fi
  cur="$(trap -p EXIT)"
  eval "prior=$(sed -n 's/^trap -- //; s/ EXIT$//p' <<<"$cur")"
  trap "$1${prior:+; $prior}" EXIT # lint-exempt: preserve any existing exit trap
}
chain_exit_trap 'rm -f -- "$wait_f" "$out/gate-wait"'
exec {mx}>"$slots/mutex"
while :; do
  flock "$mx"
  if box_has_room; then rm -f -- "$wait_f" "$out/gate-wait"; break; fi
  : >"$wait_f"; [[ -f $out/gate-wait ]] || date +%s >"$out/gate-wait"; wait_stale_drop
  flock -u "$mx"; sleep 30
done
# MCP, plugins, skills, hooks and memory are switched off in ~/.zcode/cli/config.json (features.* = false).
# Node's fetch ignores HTTP(S)_PROXY unless NODE_USE_ENV_PROXY=1, and WSL reaches Z.ai only through the proxy.
# Own memory-capped scope, named luna-* so health-watch's memory relief covers it like a codex run.
# One CPU budget across agent runs (maintainer 10-29 [...]); shared with dispatch-codex.sh.
source "${ZF_ENGINE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}/thread-budget.sh" && agent_thread_budget
source "${ZF_ENGINE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}/lib.d/worker-output-cap.sh"
scope="luna-zc-${key//[^A-Za-z0-9_-]/-}-$$"
TMPDIR="$root/tmp/$key" PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/install-guard:$root/bin:$PATH" COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NODE_USE_ENV_PROXY=1 BASH_MAX_OUTPUT_LENGTH="$(worker_output_cap_chars)" \
  systemd-run --user --scope --quiet --unit="$scope" -p MemoryMax="${LUNA_MEM_MAX:-4G}" -p CPUQuota="${LUNA_CPU_QUOTA:-${AGENT_WORKER_CPU_QUOTA:-200%}}" -p CPUWeight="$([[ "${LUNA_PRIORITY:-}" == hotfix ]] && echo 1000 || echo "${AGENT_WORKER_CPU_WEIGHT:-10}")" -p MemoryHigh="${AGENT_WORKER_MEM_HIGH:-2G}" -p TasksMax="${AGENT_WORKER_TASKS_MAX:-500}" -p MemorySwapMax=0 -p OOMPolicy=continue -- \
  "$zsrc/bin/zcode" "$zsrc/repo/apps/zcode-cli/packages/cli/dist/zcode.cjs" \
  --prompt "$(<"$prompt")" --cwd "$cwd" --mode "${ZC_MODE:-yolo}" --output-format stream-json --no-color \
  >"$out/events.jsonl" 2>"$out/stderr.log" {mx}>&- &
zpid=$!; echo "$zpid" >"$out/codex.pid"; sleep 3; flock -u "$mx"; exec {mx}>&-
wait "$zpid"; rc=$?
# stream-json writes events as the run goes (json wrote one object at exit, so bin/worker saw no progress and killed
# 27 healthy zc runs at 600 s, 10-27); the closing {"type":"result"} line carries the same .response.
jq -Rr 'fromjson? | select(.type=="result") | .response // empty' "$out/events.jsonl" >"$out/last.md" 2>/dev/null
echo "$rc" >"$out/rc"
# Leftover processes (e.g. a test database) would keep the scope alive after zcode exits; stop it once rc is recorded.
systemctl --user stop "$scope.scope" >/dev/null 2>&1 || true
exit "$rc"
}
