#!/usr/bin/env bash
# PATH shim logic for pnpm, npm and corepack: each is a tiny wrapper that execs `guard <tool> args` (no symlinks: npm pack drops them).
# Refuses an install-type command when a node_modules in the work tree is a symlink or resolves outside it.
# 2026-11-05: two review workers linked a PR worktree's node_modules to the shared deployment checkout, then ran
# `pnpm install` there; pnpm rewrote the checkout's modules dir (virtualStoreDir, xlsx links) to the worktree's
# paths, the worktree was later deleted, and 143 links dangled until release acceptance held.
# shortcut: matches the first positional word only, depth-3 node_modules only; widen if an install gets past this.
set -uo pipefail
self=$1; shift
dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
rest=() ; IFS=: read -ra parts <<<"$PATH"
for p in "${parts[@]}"; do [[ $p == "$dir" || -z $p ]] || rest+=("$p"); done
PATH=$(IFS=:; echo "${rest[*]}"); export PATH
real=$(command -v "$self") || { echo "install-guard: no real $self on PATH" >&2; exit 127; }
tool=$self args=("$@")
if [[ $self == corepack && ${1:-} =~ ^(pnpm|npm|yarn)$ ]]; then tool=$1; args=("${@:2}"); fi
verb=''
skip=0
for a in "${args[@]}"; do
  if (( skip )); then skip=0; continue; fi
  case $a in
    --filter|-F|--dir|-C|--prefix|--workspace|--registry|--reporter|--store-dir|--cwd|--config) skip=1 ;;
    -*) ;;
    *) verb=$a; break ;;
  esac
done
case $tool:$verb in
  pnpm:install|pnpm:i|pnpm:add|pnpm:update|pnpm:up|pnpm:upgrade|pnpm:remove|pnpm:rm|pnpm:uninstall|pnpm:un|pnpm:dedupe|pnpm:prune|pnpm:rebuild|pnpm:fetch) ;;
  npm:install|npm:i|npm:add|npm:ci|npm:update|npm:up|npm:uninstall|npm:remove|npm:rm|npm:dedupe|npm:prune|npm:rebuild) ;;
  *) exec "$real" "$@" ;;
esac
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
top=$(cd -- "$top" && pwd -P)
for nm in "$PWD"/node_modules "$top"/node_modules "$top"/*/node_modules "$top"/*/*/node_modules; do
  [[ -e $nm || -L $nm ]] || continue
  target=$(realpath -m -- "$nm")
  if [[ -L $nm || $target != "$top"/* ]]; then
    echo "install-guard: refusing '$tool $verb': ${nm#"$top"/} is a symlink or resolves outside this work tree ($target)." >&2
    echo "install-guard: the install would rewrite the shared directory it points to. Remove the link and install into a real directory, or do not install." >&2
    exit 1
  fi
done
exec "$real" "$@"
