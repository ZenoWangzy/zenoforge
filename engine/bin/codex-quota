#!/usr/bin/env node
// codex-quota: read the ChatGPT Codex usage (weekly, and 5h when the account reports one) from the maintainer's signed-in
// ChatGPT tab in the shared Chrome (127.0.0.1:9222, https://chatgpt.com/settings/usage). Holds Codex when the 5h
// window reaches CODEX_5H_CAP, the same way zc-quota paces ZCode. Run by vecta-codex-quota.timer.
// The page's own /backend-api/wham/usage response is read through CDP Network events, so no token passes through this script.
// Outputs under $AGENT_HOME: codex-quota.json (last reading), codex-exhausted-until (epoch seconds; lib.sh's
// provider_quota_exhausted codex reads it), codex-quota-state.json (target id of the tab this script opened,
// and the hold epoch this script wrote), log lines on stdout (journal).
import fs from 'node:fs';
const AGENT_HOME = process.env.AGENT_HOME || `${process.env.HOME}/.zenoforge`;
const STATE = `${AGENT_HOME}/codex-quota.json`;
const BOOK = `${AGENT_HOME}/codex-quota-state.json`;
const MARKER = `${AGENT_HOME}/codex-exhausted-until`;
const CAP_5H = Number(process.env.CODEX_5H_CAP || 85);  // stop starting Codex at this 5h percentage
const CDP = process.env.QUOTA_CDP_URL || 'http://127.0.0.1:9222';
const CALL_TIMEOUT_MS = Number(process.env.QUOTA_CDP_CALL_TIMEOUT_MS || 30000);
// 2026-10-31 ~19:39Z: /codex/settings/usage started redirecting to chatgpt.com/ without the usage call; the usage page is now here.
const PAGE = 'https://chatgpt.com/settings/usage';
const API = '/backend-api/wham/usage';
const sleep = ms => new Promise(r => setTimeout(r, ms));
const log = (...a) => console.log(new Date().toISOString(), ...a);
const readJson = (f, d) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch { return d; } };

try {
  // Reuse the tab this script opened (by target id). Only open one when it is missing; it stays open for the next run.
  const book = readJson(BOOK, {});
  const pages = await (await fetch(`${CDP}/json/list`)).json();
  // A tab another session turned into a chat (10-31: the advisor reused it) is theirs now; open a fresh one.
  // Match by id, not URL: the usage page redirects to chatgpt.com/, and a URL match opened a new tab every run (24 in 2h).
  let page = pages.find(p => p.type === 'page' && p.id === book.tab_id && !/chatgpt\.com\/c\//.test(p.url));
  if (!page) {
    page = await (await fetch(`${CDP}/json/new?${PAGE}`, { method: 'PUT' })).json();
    book.tab_id = page.id;
    fs.writeFileSync(BOOK, JSON.stringify(book) + '\n');  // saved now, so a failed read does not leak another tab
    log('opened ChatGPT usage tab in the shared Chrome');
  }
  const ws = new WebSocket(page.webSocketDebuggerUrl);
  let id = 0; const waits = new Map(); let hits = [];
  const call = (method, params = {}) => new Promise((r, reject) => {
    const i = ++id, t = setTimeout(() => reject(new Error(`CDP ${method} no reply in ${CALL_TIMEOUT_MS}ms`)), CALL_TIMEOUT_MS);
    waits.set(i, m => { clearTimeout(t); r(m); });
    ws.send(JSON.stringify({ id: i, method, params }));
  });
  ws.onmessage = e => {
    const m = JSON.parse(e.data);
    if (m.id) return waits.get(m.id)?.(m);
    if (m.method === 'Network.responseReceived' && new URL(m.params.response.url).pathname === API)
      hits.push({ requestId: m.params.requestId });
    if (m.method === 'Network.loadingFinished') { const h = hits.find(x => x.requestId === m.params.requestId); if (h) h.done = true; }
  };
  const evaluate = async expression => (await call('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true })).result?.result?.value;
  const body = async h => (await call('Network.getResponseBody', { requestId: h.requestId })).result?.body;

  async function readQuota() {
    hits = [];
    // Navigate, not reload: a reused tab may have drifted (redirect, another session), and a reload elsewhere never calls the usage API.
    await call('Page.navigate', { url: PAGE });
    // 40 s, the same wait as zc-quota: the usage call can be slow under load.
    for (let i = 0; i < 80 && !hits.some(h => h.done); i++) await sleep(500);
    const h = hits.find(x => x.done);
    if (!h) throw new Error('wham/usage response not seen after reload (signed out?)');
    const rl = JSON.parse(await body(h)).rate_limit || {};
    // Windows are matched by length: 18000 s = 5h, 604800 s = weekly. This account currently reports weekly only.
    const wins = [rl.primary_window, rl.secondary_window].filter(Boolean);
    const five = wins.find(w => w.limit_window_seconds === 18000);
    const week = wins.find(w => w.limit_window_seconds === 604800);
    if (!week) throw new Error(`no weekly window in rate_limit: window lengths ${JSON.stringify(wins.map(w => w.limit_window_seconds))}`);
    return { five_h_pct: five?.used_percent ?? null, five_h_reset: five?.reset_at ?? null,
             week_pct: week.used_percent, week_reset: week.reset_at ?? null, limit_reached: rl.limit_reached === true };
  }

  try {
    await new Promise((r, j) => { ws.onopen = r; ws.onerror = j; });
    await call('Network.enable').catch(async e => {
      await fetch(`${CDP}/json/close/${page.id}`);  // the next run opens a new tab
      log('closed the unresponsive usage tab');
      throw e;
    });
    const { limit_reached, ...q } = await readQuota();
    const now = Math.floor(Date.now() / 1000);
    const marker = (() => { try { return Number(fs.readFileSync(MARKER, 'utf8').trim()); } catch { return 0; } })();
    // 5h at the cap holds until the 5h window resets; a reached weekly limit holds until the weekly reset.
    const until = q.five_h_pct >= CAP_5H ? q.five_h_reset : limit_reached ? q.week_reset : null;
    if (until) {
      if (until > marker) { fs.writeFileSync(MARKER, `${until}\n`); book.hold_written = until; }
      log(`hold Codex until ${new Date(Math.max(until, marker) * 1000).toISOString()}: 5h ${q.five_h_pct}% weekly ${q.week_pct}%`);
    } else if (book.hold_written && marker === book.hold_written && marker > now) {
      fs.rmSync(MARKER, { force: true });  // only clear a hold this script wrote; a provider refusal's marker stays
      delete book.hold_written;
      log(`release Codex hold: 5h ${q.five_h_pct}% weekly ${q.week_pct}%`);
    }
    fs.writeFileSync(BOOK, JSON.stringify(book) + '\n');
    fs.writeFileSync(STATE, JSON.stringify({ ...q, read_at: now, cap_5h: CAP_5H }) + '\n');
    const iso = t => t ? new Date(t * 1000).toISOString() : 'not reported';
    log(`5h ${q.five_h_pct ?? 'n/a'}% (reset ${iso(q.five_h_reset)}) weekly ${q.week_pct}% (reset ${iso(q.week_reset)})`);
  } finally { ws.close(); }
} catch (e) {
  log('codex-quota failed:', e.message); process.exitCode = 1;
} finally {
  setTimeout(() => process.exit(), 1000);  // a hung peer never finishes the close handshake
}
