#!/usr/bin/env bash
set -euo pipefail
provider="$1" access="$2" repo="$3" capture="$4"
shift 4
[[ "${1:-}" == -- ]] || exit 64
shift
[[ "${ZF_AGENT_TEST_MODE:-0}" != 1 || -z "${ZF_AGENT_TEST_ROOT:-}" ]] || exec "$@"
engine_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
command=(python3 "$engine_root/bin/agent-sandbox.py" --provider "$provider" --access "$access" --repo "$repo" --engine-root "$engine_root")
[[ -z "$capture" ]] || command+=(--capture-output "$capture")
exec "${command[@]}" -- "$@"
