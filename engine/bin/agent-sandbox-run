#!/usr/bin/env bash
# 2026-11-28 founder: 「不要沙盒，以后禁止」 and 「现在要的是效率和速度，不要搞无用的沙盒和测试」.
# Workers run directly in their checkout on the host shell. The sandbox dropped GitHub credentials, so gh pr create and git fetch failed (#1722, #1723).
set -euo pipefail
repo="$3"
shift 4
[[ "${1:-}" == -- ]] || exit 64
shift
cd -- "$repo"
exec "$@"
