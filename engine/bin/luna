#!/usr/bin/env bash
# Run one Codex agent non-interactively, the way the pipeline launches workers.
# Model and effort: CODEX_MODEL (default gpt-6-luna) and CODEX_EFFORT (default max); use gpt-6.1-sol for heavy batches.
# CODEX_SEARCH=1 enables live web search.
# Usage: luna <key> <cwd> <prompt-file> [output-schema.json]
# Writes .scratch/luna/<key>/{last.md,events.jsonl,stderr.log,rc}; remote runs sync these files to the local scratch.
set -uo pipefail
# The whole body is one { ... } block, so bash parses it before running any of it: editing this file while jobs
# run cannot make a running job read the new bytes at its old offset (2026-10-24: six wrappers deadlocked that way).
# Replace this file atomically (write a temp file, then mv) all the same.
{
key="$1" cwd="$2" prompt="$3" schema="${4:-}"
root=${WORKER_SCRATCH_ROOT:-${HOME:-/tmp}/.zenoforge/scratch}
out="$root/luna/$key"
mkdir -p "$out" "$root/tmp/$key"
rm -f "$out/rc" "$out/codex.pid"; echo $$ >"$out/wrapper.pid"   # health-watch reads these
run_cwd="$cwd"; [[ "$run_cwd" == /* ]] || run_cwd="$PWD/$run_cwd"; printf '%s\n' "$run_cwd" >"$out/cwd"
engine_dir="${ZF_ENGINE_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}"
agent_sandbox="$engine_dir/bin/agent-sandbox-run"
task_state_home="${AGENT_HOME:-${ZF_HOME:-${HOME:-$root}/.zenoforge}}"
task_resume="$root/tmp/$key/task-resume.md"
resumed_prompt="$root/tmp/$key/prompt-with-task-resume.md"
node "$engine_dir/task-state.mjs" resume "$task_state_home/task-state" >"$task_resume" || exit 1
{ printf '## Task state at session start\n\n' && cat "$task_resume" && printf '\n## Requested task\n\n' && cat "$prompt"; } >"$resumed_prompt" || exit 1
prompt="$resumed_prompt"
# Shared with bin/zc (lib.d/worker-remote-handoff.sh): a remote run exits there; a refusal falls back to the local gate below.
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/lib.d/worker-remote-handoff.sh"
worker_remote_handoff luna "$out" "$key" "$cwd" "$prompt" "$schema"
# The local host gate keeps WSL responsive (maintainer, 2026-10-24: scale worker count with CPU load). A local run starts only while the box has room:
#   - always, if fewer than LUNA_MIN (2) runs are going and at least 2 GB is available;
#   - otherwise only below LUNA_MAX (10) runs, with sampled CPU busy under LUNA_CPU_TARGET (85%), memory pressure
#     under 5% and at least 3 GB available (maintainer 2026-10-24: keep the box near 85% busy).
# Runs count every luna/zc scope under zf-workers.slice, including session-launched workers.
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/luna-capacity.sh"
slots="${LUNA_SLOTS:-$root/tmp/luna-slots}"; mkdir -p "$slots"
# A run that cannot start yet publishes wait-<prio>-<pid> (prio = LUNA_PRIORITY, pid = this wrapper): the autopilot
# scheduler holds new ordinary workers while a hotfix/opt run queues here (#4621, maintainer 10-29 strict priority
# hotfix > opt > 普通 pipeline). Removed on start and on exit; a wrapper killed while waiting leaves a stale file
# that whoever sees next drops (the scheduler's higher_priority_waiting does the same check).
prio="${LUNA_PRIORITY:-normal}"; wait_f="$slots/wait-$prio-$$"
chain_exit_trap() {
  local cur prior
  if [[ "$BASHPID" != "$$" && "${chain_exit_trap_pid:-}" != "$BASHPID" ]]; then
    chain_exit_trap_pid=$BASHPID; trap "$1" EXIT # lint-exempt: first EXIT trap in a subshell
    return 0
  fi
  cur="$(trap -p EXIT)"
  eval "prior=$(sed -n 's/^trap -- //; s/ EXIT$//p' <<<"$cur")"
  trap "$1${prior:+; $prior}" EXIT # lint-exempt: preserve any existing exit trap
}
# The remote account is never root (the placement probe refuses uid 0) and has linger on, so local and
# remote scopes both live in the user manager.
chain_exit_trap 'rm -f -- "$wait_f" "$out/gate-wait"; [[ -z "${scope:-}" ]] || systemctl --user stop "$scope.scope" >/dev/null 2>&1 || true'
if [[ ${ZF_WORKER_REMOTE_INNER:-0} != 1 ]]; then
  wait_attempt=0 gate_reload_at=""
  while :; do
    [[ -e "$wait_f" ]] || printf '%(%s)T\n' -1 >"$wait_f"
    [[ -e "$wait_f" ]] || { echo "luna: cannot publish capacity ticket $wait_f" >&2; exit 74; }
    if [[ ! "$gate_reload_at" =~ ^[0-9]+$ ]] || (( SECONDS - gate_reload_at >= ${LUNA_GATE_RELOAD_SECONDS:-60} )); then
      luna_reload_live_gate
      gate_reload_at=$SECONDS
    fi
    luna_reload_gate_env
    if luna_waiter_has_room "$slots" "$wait_f" "$prio" "$SECONDS" luna; then break; fi
    [[ -e "$wait_f" ]] || { echo "luna: capacity ticket disappeared: $wait_f" >&2; exit 74; }
    [[ -f $out/gate-wait ]] || printf '%(%s)T\n' -1 >"$out/gate-wait"
    luna_wait_backoff "$wait_attempt"
    wait_attempt=$((wait_attempt + 1))
    luna_waiter_sleep "$slots" "$LUNA_WAIT_DELAY" || { echo 'luna: could not wait on capacity gate' >&2; exit 74; }
  done
else
  scope="${ZF_WORKER_REMOTE_SCOPE_NAME:-}"
  [[ "$scope" =~ ^zf-remote-[A-Za-z0-9_-]+-[0-9a-f]{8}$ ]] || { echo 'luna: invalid remote scope name' >&2; exit 2; }
  # A user manager without a delegated cpu controller refuses CPUWeight: log one line and run without the weight.
  systemctl --user set-property --runtime zf-remote.slice "CPUWeight=${ZF_WORKER_REMOTE_CPU_WEIGHT:-20}" >/dev/null 2>&1 \
    || echo 'luna: could not set zf-remote.slice CPUWeight (running without it)' >&2
  printf '%s\n' "$scope" >"$out/remote.scope"
fi
# Workers need no MCP servers; each codex run otherwise spawns chrome-devtools, gbrain and gitnexus (~360 MB).
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib.d" && pwd -P)/codex-mcp.sh"
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib.d" && pwd -P)/worker-output-cap.sh"
source "$engine_dir/matt-skills.sh"
matt_codex_context_prepare "$run_cwd"
args=(exec "${MATT_CODEX_CONTEXT_ARGS[@]}" "${CODEX_PLUGINS_OFF_ARGS[@]}" -m "${CODEX_MODEL:-gpt-6-luna}" -c "model_reasoning_effort=\"${CODEX_EFFORT:-max}\"" -c shell_environment_policy.inherit=all
  -c "tool_output_token_limit=$(worker_output_cap_tokens)" -s danger-full-access -o "$out/last.md" --json)
[[ -n "$schema" ]] && args+=(--output-schema "$schema")
# Each run lives in its own cgroup scope with a memory cap, so one runaway tool (2026-10-24: three shellcheck runs
# took 8.7 GB and pushed memory pressure to 32%) is OOM-killed inside its job instead of freezing WSL.
# One CPU budget across agent runs (maintainer 10-29 [...]); shared with dispatch-codex.sh.
source "${ZF_ENGINE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}/thread-budget.sh" && agent_thread_budget
[[ ${ZF_WORKER_REMOTE_INNER:-0} == 1 ]] || scope="luna-${key//[^A-Za-z0-9_-]/-}-$$"
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
mem_high="${LUNA_MEM_HIGH:-$(source "$engine_dir/config.sh" >/dev/null 2>&1 && zf_worker_mem_cap mem_high)}"
mem_max="${LUNA_MEM_MAX:-$(source "$engine_dir/config.sh" >/dev/null 2>&1 && zf_worker_mem_cap mem_max)}"
systemd_args=(--user --scope --quiet --slice="${ZF_WORKER_SLICE:-zf-workers.slice}" --unit="$scope")
cpu_weight="${AGENT_WORKER_CPU_WEIGHT:-10}"
if [[ ${ZF_WORKER_REMOTE_INNER:-0} == 1 ]]; then cpu_weight="${ZF_WORKER_REMOTE_CPU_WEIGHT:-20}"
elif [[ ${LUNA_PRIORITY:-} == hotfix ]]; then cpu_weight=1000; fi
codex_mcp_context_mode_sentinel_dir "$root/tmp/$key" && TMPDIR="$root/tmp/$key" PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/install-guard:$root/bin:$PATH" COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
  systemd-run "${systemd_args[@]}" -p MemoryHigh="${mem_high:-1536M}" -p MemoryMax="${mem_max:-2G}" -p CPUQuota="${LUNA_CPU_QUOTA:-${AGENT_WORKER_CPU_QUOTA:-200%}}" -p CPUWeight="$cpu_weight" -p TasksMax="${AGENT_WORKER_TASKS_MAX:-500}" -p MemorySwapMax=0 -p OOMPolicy=continue -- \
  "$agent_sandbox" codex "${ZF_AGENT_ACCESS:-read}" "$run_cwd" "$out/last.md" -- codex ${CODEX_SEARCH:+--search} "${args[@]}" - < <(matt_codex_prompt_input "$prompt" "$run_cwd" "$MATT_CODEX_CONTEXT_ROOT") >"$out/events.jsonl" 2>"$out/stderr.log" &
cpid=$!; echo "$cpid" >"$out/codex.pid"; sleep 3; rm -f -- "$wait_f" "$out/gate-wait"
# Sample the scope's memory.peak while it lives: systemd reaps the cgroup the moment the run ends (11-21: four
# ended runs had no scope dir left at a read after wait), so the peak must come from a read made during the run.
peak_sample="$root/tmp/$key/scope-peak.sample"
declare -F luna_watch_scope_peak >/dev/null 2>&1 && luna_watch_scope_peak "$scope" "$cpid" "$peak_sample" &
wait "$cpid"; rc=$?
# Record the last peak read while the scope lived; none readable at any time records nothing and leaves rc alone.
read -r peak_bytes < "$peak_sample" 2>/dev/null || peak_bytes=''
declare -F luna_record_scope_peak >/dev/null 2>&1 && luna_record_scope_peak luna "$scope" "$peak_bytes"
rm -f -- "$peak_sample"
echo "$rc" >"$out/rc"
# EXIT cleanup also stops the scope if the wrapper is interrupted after launch.
exit "$rc"
}
