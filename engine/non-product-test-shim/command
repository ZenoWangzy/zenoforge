#!/usr/bin/python3
"""Block test execution from scheduler direct-main workers."""
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
from urllib.parse import quote


SHIM_FILE = Path(__file__).resolve()
SHIM_DIR = SHIM_FILE.parent
COMMAND = Path(sys.argv[0]).name
ARGS = sys.argv[1:]


def real_command():
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(entry or ".") / COMMAND
        try:
            if candidate.resolve() == SHIM_FILE:
                continue
            if candidate.is_file() and os.access(candidate, os.X_OK):
                return str(candidate)
        except OSError:
            continue
    return None


def test_file(value):
    return bool(re.search(r"(?:^|[/\\])[^/\\]+\.test\.[^/\\]+$", value))


def blocked_reason():
    test_flags = any(arg == "--test" or arg.startswith("--test=") for arg in ARGS)
    if COMMAND == "node":
        if test_flags:
            return "node-test"
        if "--check" in ARGS:
            return ""
        return "test-file" if any(test_file(arg) for arg in ARGS) else ""
    if COMMAND == "pnpm":
        if test_flags:
            return "node-test"
        value_flags = {"--filter", "-F", "--dir", "-C", "--config"}
        i = 0
        while i < len(ARGS):
            arg = ARGS[i]
            if arg in value_flags:
                i += 2
                continue
            if arg.startswith("-"):
                i += 1
                continue
            if arg == "test" or arg.startswith("test:"):
                return "pnpm-test"
            if arg == "run" and i + 1 < len(ARGS) and ARGS[i + 1].startswith("test"):
                return "pnpm-test"
            break
        if "--check" not in ARGS and any(test_file(arg) for arg in ARGS):
            return "test-file"
        return ""
    if COMMAND in {"bash", "sh"}:
        if any(arg == "-n" for arg in ARGS):
            return ""
        i = 0
        while i < len(ARGS):
            arg = ARGS[i]
            if arg == "--" or arg == "-" or not arg.startswith("-"):
                break
            if arg.startswith("--"):
                if COMMAND != "bash":
                    break
                i += 2 if arg in {"--init-file", "--rcfile"} else 1
                continue
            cluster = arg[1:]
            while cluster:
                option, cluster = cluster[0], cluster[1:]
                if option == "c":
                    return ""
                if option in {"o", "O"}:
                    i += 1 if cluster else 2
                    break
            else:
                i += 1
    if COMMAND in {"python", "python3"} and len(ARGS) >= 2 and ARGS[:2] == ["-m", "py_compile"]:
        return ""
    return "test-file" if any(test_file(arg) for arg in ARGS) else ""


def login_shell_script_index():
    if COMMAND not in {"bash", "sh"} or any(arg == "-n" for arg in ARGS):
        return None
    login = False
    i = 0
    while i < len(ARGS):
        arg = ARGS[i]
        if arg == "--" or arg == "-" or not arg.startswith("-"):
            break
        if arg.startswith("--"):
            if COMMAND != "bash":
                break
            if arg == "--login":
                login = True
            i += 2 if arg in {"--init-file", "--rcfile"} else 1
            continue
        cluster = arg[1:]
        skip_cluster = False
        while cluster:
            option, cluster = cluster[0], cluster[1:]
            if option == "l":
                login = True
            elif option == "c":
                login = login or "l" in cluster
                return i + 1 if login and i + 1 < len(ARGS) else None
            elif option in {"o", "O"}:
                i += 1 if cluster else 2
                skip_cluster = True
                break
        if not skip_cluster:
            i += 1
    return None


def refused_path():
    # The matched test file, percent-encoded so the marker stays one token; "-" when no file was named (node --test).
    value = next((arg for arg in ARGS if test_file(arg)), "")
    return quote(value, safe="/._-+@:") or "-"


def record_violation(reason):
    reporter = SHIM_DIR.parent / "execution-admission.py"
    command_name = COMMAND if COMMAND in {"node", "pnpm", "bash", "sh", "python", "python3"} else "unknown"
    result = subprocess.run(
        ["/usr/bin/python3", str(reporter), "record-test-violation", command_name, reason],
        env=os.environ.copy(), check=False,
    )
    return result.returncode == 0


if os.environ.get("ZF_NON_PRODUCT_UNIT") == "1":
    reason = blocked_reason()
    if reason:
        recorded = record_violation(reason)
        unit = os.environ.get("ZF_PIPELINE_UNIT", "unknown")
        line = f"non-product-test-guard: refused unit={unit} command={COMMAND} reason={reason} path={refused_path()} recorded={int(recorded)}"
        if guard_file := os.environ.get("ZF_NON_PRODUCT_GUARD_FILE"):
            try:
                with open(guard_file, "a", encoding="utf-8") as stream:
                    stream.write(line + "\n")
            except OSError:
                pass
        print(
            line,
            file=sys.stderr,
        )
        sys.exit(78)

real = real_command()
if not real:
    print(f"non-product-test-guard: {COMMAND} unavailable", file=sys.stderr)
    sys.exit(127)
exec_args = ARGS
if os.environ.get("ZF_NON_PRODUCT_UNIT") == "1":
    script_index = login_shell_script_index()
    if script_index is not None:
        exec_args = ARGS.copy()
        exec_args[script_index] = f"PATH={shlex.quote(str(SHIM_DIR))}:$PATH; {ARGS[script_index]}"
os.execv(real, [real, *exec_args])
