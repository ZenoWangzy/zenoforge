{
  "schema_version": 3,
  "roles": {
    "work": {
      "provider": "codex",
      "model": "gpt-6-luna",
      "effort": "max",
      "service_tier": "fast"
    },
    "production": {
      "provider": "codex",
      "model": "gpt-6-luna",
      "effort": "high"
    },
    "advisor": {
      "provider": "web-advisor-provider",
      "model": "gpt6",
      "disabled": true
    },
    "hand-zcode": {
      "provider": "zcode",
      "model": "GLM-5.3",
      "effort": "max",
      "disabled": true
    },
    "hand-claude": {
      "provider": "claude",
      "model": "claude-haiku-5-5",
      "effort": "high"
    },
    "triage-haiku": {
      "provider": "claude",
      "model": "claude-haiku-5-5",
      "effort": "high"
    },
    "review": {
      "provider": "zcode",
      "model": "GLM-5.3",
      "effort": "max"
    },
    "unit-review": {
      "provider": "codex",
      "model": "gpt-6-luna",
      "effort": "max",
      "service_tier": "fast",
      "fallback_model": "gpt-6-luna"
    },
    "unit-review-cross": {
      "provider": "zcode",
      "model": "GLM-5.3",
      "effort": "max"
    },
    "unit-implement": {
      "provider": "codex",
      "model": "gpt-6-luna",
      "effort": "max",
      "service_tier": "fast",
      "fallback_model": "gpt-6-luna"
    },
    "unit-triage": {
      "provider": "codex",
      "model": "gpt-6-luna",
      "effort": "max",
      "service_tier": "fast",
      "fallback_model": "gpt-6-luna"
    },
    "unit-review-fallback": {
      "provider": "claude",
      "model": "claude-haiku-5-5",
      "effort": "high"
    },
    "unit-implement-hotfix": {
      "provider": "codex",
      "model": "gpt-6.1-terra",
      "effort": "high",
      "fallback_model": "gpt-6-luna"
    }
  },
  "allow_roles": {
    "sonnet": ["hand-claude"],
    "haiku": ["triage-haiku", "hand-claude", "review_fallback", "unit-review-fallback"],
    "terra": ["unit-implement-hotfix"]
  },
  "escalation": {
    "initial_step": "work",
    "steps": [
      {
        "name": "work",
        "role": "work",
        "on_failure": "work"
      },
      {
        "name": "advisor",
        "role": "advisor",
        "on_success": "work_retry",
        "on_failure": "wait"
      },
      {
        "name": "work_retry",
        "role": "work",
        "attempts": 1,
        "on_failure": "conclude"
      },
      {
        "name": "conclude"
      }
    ]
  },
  "hand_loop_breaker": {
    "work_no_progress_limit": 2
  },
  "switches": {
    "roadmap-order": true
  },
  "forbidden": [
    "sol",
    "astra",
    "terra",
    "gpt-5",
    "claude",
    "sonnet",
    "opus",
    "fable"
  ],
  "model_families": {
    "codex": ["codex:gpt-*:*", "codex:luna:*", "codex:terra:*", "gpt-*", "luna", "terra"],
    "glm": ["zcode:*", "GLM-*", "glm-*"],
    "claude": ["claude:*", "claude-*"]
  }
}
