{
  "max_workers": 10,
  "dispatch_priority_order": ["hotfix", "opt", "normal"],
  "tick_seconds": 120,
  "engine": {
    "canary_ticks": 2,
    "worker_tasks_max": 500,
    "mem_admission": {
      "calibrate": false,
      "estimates_mb": {
        "implement": 1024,
        "repair": 1024,
        "review": 1024,
        "advisor": 1024
      }
    },
    "eval_on_pin": {
      "enabled": true,
      "stages": null,
      "timeout_minutes": 45
    }
  },
  "station_health": {
    "stall_minutes": {"intake": 90, "triage": 360, "advisor": 810, "implement": 60, "review": 60, "repair": 90, "merge": 150, "ci": 100, "release": 950}
  },
  "auto_merge": true,
  "merge_gate": {
    "pipeline_suites": "auto",
    "main_workflow": "Pipeline suites"
  },
  "auto_dispatch_new_prs": true,
  "issue_intake": {
    "enabled": true,
    "max_upstream": null,
    "max_ready": 30,
    "labels": [],
    "product_labels": ["ready-for-agent"],
    "author_routes": {"OWNER": "admit", "MEMBER": "admit", "COLLABORATOR": "admit"},
    "trusted_authors": [],
    "ready_buffer": null,
    "refill_max": 2,
    "refill_max_footprint_candidates": 4,
    "refill_full_tick_fresh_seconds": 600,
    "remote_reads_per_tick": 24
  },
  "incident": {
    "labels": ["bug", "incident", "production-anomaly"],
    "file_min_severity": "medium"
  },
  "hotfix_lane": {
    "branch_prefixes": ["hotfix/", "agent/issue-hf-"],
    "label": "hotfix",
    "supervisor_owned": true
  },
  "auto_triage_new_issues": false,
  "intake_priority": {
    "enabled": true,
    "labels": {
      "top": "priority:top",
      "high": "priority:high",
      "normal": "priority:normal",
      "low": "priority:low",
      "needs_triage": "priority:unsure",
      "route_prefix": "route:"
    },
    "score_thresholds": {"normal": 0.5, "high": 1.5, "top": 2.5},
    "minimum_confidence": 0.9,
    "founder_issues": [3066, 5663, 5665, 6120, 6121, 6123, 6124, 6126, 6130, 6131, 6133, 6167, 6226, 6235, 6237, 6238, 6601, 6611],
    "off_market_terms": ["体育", "赛事", "版权", "转播", "球队", "联赛", "运动员", "sports", "broadcast rights", "league", "athlete"],
    "off_market_issues": [6289, 6288, 6208, 5421, 5341, 5329, 5298, 4620, 3299, 1159, 1158]
  },
  "focus_mode": "all",
  "budget_meter": "sessions_dir",
  "daily_token_budget": 10000000,
  "pricing": {
    "gpt-6-luna": {
      "in": 0.10,
      "cached": 0.01,
      "out": 0.50
    },
    "gpt-5.6-terra": {
      "in": 2.00,
      "cached": 0.20,
      "out": 12.00
    },
    "default": {
      "in": 0.10,
      "cached": 0.01,
      "out": 0.50
    }
  },
  "pricing_note": "默认参考 OpenAI API 标准文本 token 公价作等值估算（美元/百万 token；GPT-6 Luna 输入/缓存/输出 $0.10/$0.01/$0.50，GPT-5.6 Terra $2/$0.20/$12）；不是 Codex/ChatGPT 订阅账单。config.pricing 可覆盖单价。输入价按扣除缓存后的 token 计算；未计大上下文加价、处理档位、缓存写入或工具调用费用。",
  "loop_breaker_rounds": 5,
  "size_admission_lines": 800,
  "pr_create_retry_limit": 3,
  "size_admission": {
    "exempt_hotpatch": true
  },
  "ticket_round_budget": 3,
  "ticket_wall_budget_minutes": 240,
  "token_park_soft_tokens": 1200000,
  "token_park_hard_tokens": 2400000,
  "stacking": {
    "enabled": true,
    "pilot_label": "stack-pilot"
  },
  "footprint_mutex": {
    "convoy_min_waiters": 4,
    "convoy_wait_minutes": 15,
    "shared_append": [
      "packages/example-pack/src/db/schema.ts",
      "packages/example-pack/src/db/runtime-permissions.ts",
      "packages/example-pack/src/v4/register-tools.ts"
    ]
  },
  "waste": {
    "slow_worker_minutes": 60,
    "burn_tokens_no_output": 800000,
    "stuck_confirm_minutes": 10,
    "max_no_output": 2,
    "tool_output_cap_kb": 64
  },
  "models": {
    "review": [
      "gpt-6-luna",
      "max",
      "fast"
    ],
    "review_cross": [
      "GLM-5.3",
      "max"
    ],
    "implement": [
      "gpt-6-luna",
      "max",
      "fast"
    ],
    "implement_share": {
      "claude": 50,
      "codex": 50,
      "zcode": 0
    },
    "triage": [
      "gpt-6-luna",
      "max",
      "fast"
    ],
    "review_fallback": [
      "claude-haiku-5-5",
      "high"
    ],
    "implement_hotfix": [
      "gpt-6.1-terra",
      "high"
    ]
  },
  "bell": {
    "enabled": true,
    "dedup_minutes": 30
  },
  "supervisor_arbiter": {
    "enabled": true,
    "profile": "terra",
    "needs_info_per_tick": 3,
    "cap_triage": true,
    "cap_triage_per_tick": 3,
    "unit_cap": 4
  },
  "notes": "发布批次需要 release train 出车。release_train.enabled=false 是线级 hold：要登记 release_train.hold = {owner, reason, expires_at}（expires_at 用 ISO UTC，例如 {\"owner\":\"ops\",\"reason\":\"demo 11-03，结束后恢复\",\"expires_at\":\"2026-11-04T18:00:00Z\"}）；缺 owner、缺到期或已过期会每天告警一条（holds.line_violations），过期只告警、绝不自动恢复。",
  "implement_cap": 8,
  "release_train": {
    "enabled": false,
    "hold": null
  },
  "precheck": false,
  "implement_command_cap": 230
}
