[Unit]
Description=the product maintainer health mail tick
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.zenoforge/checkout
Environment=AGENT_HOME=%h/.zenoforge
Environment=ZF_HOME=%h/.zenoforge
Environment=ZF_NIGHT_DIR=%h/.zenoforge/night
Environment=ZF_REPO_DIR=%h/.zenoforge/checkout
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=http_proxy=http://127.0.0.1:3128 https_proxy=http://127.0.0.1:3128
Environment=HTTP_PROXY=http://127.0.0.1:3128 HTTPS_PROXY=http://127.0.0.1:3128
Environment=no_proxy=127.0.0.1,localhost,192.168.0.0/16,10.0.0.0/8
Environment=NO_PROXY=127.0.0.1,localhost,192.168.0.0/16,10.0.0.0/8
TimeoutStartSec=132
EnvironmentFile=-%h/.zenoforge/engine.env
# Engine-live pointer, else the checkout path; ":" stops systemd expanding $ (see zenoforge-agent.service).
ExecStart=:/bin/bash -c 'e="$(readlink -e %h/.zenoforge/engine-live 2>/dev/null)"; if [ -n "$e" ]; then export ZF_ENGINE_DIR="$e" ZF_ENGINE_LIVE="$e"; [ -z "${ZF_PACK_DIR-}" ] || export ZF_PACK_DIR="$e"; for v in ZF_RELEASE_TRAIN_SCRIPT AGENT_INCIDENT_GUARDS_FILE ZF_PRODUCTION_TENANT_MARKER_EXCEPTIONS_FILE; do p="${!v-}"; case "$p" in %h/.zenoforge/engine-live/*) export "$v=$e/${p#%h/.zenoforge/engine-live/}";; esac; done; fi; exec "${e:-%h/.zenoforge/checkout/engine}/night/health-maintenance.sh" founder-mail'
