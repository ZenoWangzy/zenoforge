# Runs supervise-pipeline.sh (engine/supervise-pipeline.sh) as a
# systemd --user oneshot, triggered by zenoforge-supervisor.timer. Same
# PATH/proxy/GH_TOKEN environment shape as zenoforge-agent.service/zf-
# label-churn.service -- see zenoforge-agent.service's own header comment for
# why each of these is required under a systemd --user unit (it does not
# source ~/.bashrc). Points at the same dedicated, never-touched-
# interactively checkout ($HOME/.zenoforge/checkout) the other
# units use, but does NOT fast-forward it itself, same reasoning as
# zenoforge-label-churn.service: this reads gh/systemctl/journalctl/local
# state and spend files, none of which come from the repo's own code, so a
# stale checkout only means stale threshold constants, never stale data --
# and run-tick.sh's own unit self-install loop (its own comment, "no
# linger is configured... copies engine/systemd/*.service/*.timer
# into ~/.config/systemd/user/") is what actually brings a changed version
# of THIS file live, the same path every other unit in this directory
# already relies on.
[Unit]
Description=the product issue-pipeline supervisor (system-level invariants)

[Service]
Type=oneshot
WorkingDirectory=%h/.zenoforge/checkout
Environment=ZF_REPO_DIR=%h/.zenoforge/checkout
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
StandardOutput=journal
StandardError=journal
EnvironmentFile=-%h/.zenoforge/engine.env
# Engine-live pointer, else the checkout path; ":" stops systemd expanding $ (see zenoforge-agent.service).
ExecStart=:/bin/bash -c 'e="$(readlink -e %h/.zenoforge/engine-live 2>/dev/null)"; if [ -n "$e" ]; then export ZF_ENGINE_DIR="$e" ZF_ENGINE_LIVE="$e"; [ -z "${ZF_PACK_DIR-}" ] || export ZF_PACK_DIR="$e"; for v in ZF_RELEASE_TRAIN_SCRIPT AGENT_INCIDENT_GUARDS_FILE ZF_PRODUCTION_TENANT_MARKER_EXCEPTIONS_FILE; do p="${!v-}"; case "$p" in %h/.zenoforge/engine-live/*) export "$v=$e/${p#%h/.zenoforge/engine-live/}";; esac; done; fi; exec "${e:-%h/.zenoforge/checkout/engine}/supervise-pipeline.sh"'
